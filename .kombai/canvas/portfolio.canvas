      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@300;400;500;700&display=swap');\n\n    :root {\n        --color-bg: #F7F7F7;\n        --color-text: #1B1B1B;\n        --color-accent: #FF3800;\n        --font-heading: 'Anton', sans-serif;\n        --font-body: 'Space Grotesk', sans-serif;\n    }\n\n    body {\n        background-color: var(--color-bg);\n        color: var(--color-text);\n        font-family: var(--font-body);\n        margin: 0;\n        cursor: none; /* Hide default cursor */\n    }\n\n    .font-anton { font-family: var(--font-heading); }\n    .font-space { font-family: var(--font-body); }\n\n    #magnetic-cursor {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 110px;\n        height: 110px;\n        border: 1px solid var(--color-accent);\n        border-radius: 50%;\n        pointer-events: none;\n        z-index: 9999;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        mix-blend-mode: difference;\n        backdrop-filter: invert(1) grayscale(1);\n    }\n\n    #magnetic-cursor .dot {\n        width: 4px;\n        height: 4px;\n        background-color: var(--color-accent);\n        border-radius: 50%;\n    }\n\n    .manifesto-container {\n        max-width: 320px;\n        margin-left: auto;\n    }\n\n    .project-image-preview {\n        position: fixed;\n        width: 400px;\n        height: 560px;\n        pointer-events: none;\n        z-index: 100;\n        overflow: hidden;\n        opacity: 0;\n        transform: scale(0.8);\n        filter: grayscale(1);\n    }\n\n    .project-image-preview img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n    }\n\n    .reveal-text {\n        overflow: hidden;\n    }\n\n    .reveal-text span {\n        display: block;\n    }\n\n    /* Custom Selection Color */\n    ::selection {\n        background: var(--color-accent);\n        color: white;\n    }\n</style>\n\n\n<div id=\"magnetic-cursor\" data-kid=\"1\">\n    <div class=\"dot\" data-kid=\"2\"></div>\n</div>\n\n\n<div id=\"hover-preview\" class=\"project-image-preview\" data-kid=\"3\">\n    <img src=\"https://images.unsplash.com/photo-1699459867169-515c14378f79?auto=format&w=800&q=80&fit=crop\" alt=\"Work Preview\" decoding=\"async\" loading=\"lazy\" data-kid=\"4\">\n</div>\n\n<main class=\"relative z-10\" data-kid=\"5\">\n    \n    <section class=\"min-h-screen flex items-center px-6 md:px-12 relative overflow-hidden\" data-kid=\"6\">\n        <div class=\"w-full max-w-[1600px] mx-auto\" data-kid=\"7\">\n            <h1 class=\"font-anton text-[15vw] md:text-[13vw] leading-[0.95] uppercase tracking-tighter\" id=\"hero-title\" data-kid=\"8\">\n                <div class=\"reveal-text\" data-kid=\"9\"><span data-kid=\"10\">WE BUILD</span></div>\n                <div class=\"reveal-text md:ml-[10%]\" data-kid=\"11\"><span data-kid=\"12\">DIGITAL</span></div>\n                <div class=\"reveal-text md:ml-[20%]\" data-kid=\"13\"><span data-kid=\"14\">REALITIES</span></div>\n            </h1>\n        </div>\n        \n        <div class=\"absolute bottom-24 right-12 text-xs font-bold tracking-[0.5em] uppercase opacity-40 md:block hidden transform rotate-90 origin-right\" data-kid=\"15\">\n            International Style / 47.3769° N\n        </div>\n    </section>\n\n    \n    <section class=\"py-48 px-6 md:px-12\" data-kid=\"16\">\n        <div class=\"mb-24 flex items-end justify-between border-b-2 border-black pb-6\" data-kid=\"17\">\n            <h2 class=\"font-anton text-5xl uppercase tracking-tighter\" data-kid=\"18\">Selected Works</h2>\n            <p class=\"text-[10px] font-bold uppercase tracking-[0.5em] opacity-40\" data-kid=\"19\">[001 — 003]</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12\" data-kid=\"20\">\n            <div class=\"md:col-span-8 space-y-0\" id=\"project-list\" data-kid=\"21\">\n                <div class=\"project-item group border-b border-black/10 py-12 md:py-20 flex flex-col md:flex-row md:items-baseline justify-between cursor-pointer\" data-img=\"https://images.unsplash.com/photo-1699459867169-515c14378f79?auto=format&w=800&q=80&fit=crop\" data-kid=\"22\">\n                    <div class=\"relative\" data-kid=\"23\">\n                        <span class=\"font-anton text-6xl md:text-9xl uppercase leading-none group-hover:italic transition-all duration-500\" data-kid=\"24\">Aethelgard</span>\n                        <div class=\"absolute -left-10 top-0 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"25\">01</div>\n                    </div>\n                    <span class=\"text-xs font-bold uppercase tracking-widest mt-4 md:mt-0 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"26\">Visual Identity & Web Experience</span>\n                </div>\n\n                <div class=\"project-item group border-b border-black/10 py-12 md:py-20 flex flex-col md:flex-row md:items-baseline justify-between cursor-pointer\" data-img=\"https://images.unsplash.com/photo-1779675258712-165826aa6969?auto=format&w=800&q=80&fit=crop\" data-kid=\"27\">\n                    <div class=\"relative\" data-kid=\"28\">\n                        <span class=\"font-anton text-6xl md:text-9xl uppercase leading-none group-hover:italic transition-all duration-500\" data-kid=\"29\">Nova Core</span>\n                        <div class=\"absolute -left-10 top-0 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"30\">02</div>\n                    </div>\n                    <span class=\"text-xs font-bold uppercase tracking-widest mt-4 md:mt-0 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"31\">Interactive Storytelling</span>\n                </div>\n\n                <div class=\"project-item group border-b border-black/10 py-12 md:py-20 flex flex-col md:flex-row md:items-baseline justify-between cursor-pointer\" data-img=\"https://images.unsplash.com/photo-1776262145093-ab3f69760686?auto=format&w=800&q=80&fit=crop\" data-kid=\"32\">\n                    <div class=\"relative\" data-kid=\"33\">\n                        <span class=\"font-anton text-6xl md:text-9xl uppercase leading-none group-hover:italic transition-all duration-500\" data-kid=\"34\">Vortex.ai</span>\n                        <div class=\"absolute -left-10 top-0 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"35\">03</div>\n                    </div>\n                    <span class=\"text-xs font-bold uppercase tracking-widest mt-4 md:mt-0 opacity-50 group-hover:opacity-100 transition-opacity\" data-kid=\"36\">E-Commerce Architecture</span>\n                </div>\n            </div>\n            <div class=\"md:col-span-4 hidden md:flex flex-col justify-end pb-20 opacity-30 text-xs leading-relaxed uppercase font-medium\" data-kid=\"37\">\n                We focus on high-performance digital products that blend Swiss minimalism with cutting-edge motion principles.\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"min-h-screen py-48 px-6 md:px-12 flex flex-col justify-between relative\" data-kid=\"38\">\n        <div class=\"flex justify-start\" data-kid=\"39\">\n            <div id=\"asterisk-container\" class=\"w-24 h-24 md:w-32 md:h-32\" data-kid=\"40\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/star-key.svg\" class=\"w-full h-full\" style=\"filter: brightness(0) saturate(100%) invert(26%) sepia(89%) saturate(5453%) hue-rotate(352deg) brightness(98%) contrast(108%);\" alt=\"asterisk\" data-kid=\"41\">\n            </div>\n        </div>\n\n        <div class=\"flex justify-end\" data-kid=\"42\">\n            <div class=\"manifesto-container\" data-kid=\"43\">\n                <p class=\"text-[var(--color-accent)] text-[10px] font-bold uppercase tracking-[0.4em] mb-6\" data-kid=\"44\">Manifesto 01</p>\n                <div class=\"text-[var(--color-text)] text-sm md:text-base leading-relaxed text-justify font-space font-medium uppercase tracking-tight\" id=\"manifesto-text\" data-kid=\"45\">\n                    Functionality is the primary aesthetic. We specialize in the construction of modular digital systems that prioritize structural integrity over decorative excess. By eliminating the non-essential, we amplify the user's focus on content and interaction. Our work is a synthesis of rigorous layout theory and technical precision.\n                </div>\n                <div class=\"w-full h-[1px] bg-black/20 mt-12 overflow-hidden relative\" data-kid=\"46\">\n                    <div id=\"manifesto-progress\" class=\"absolute top-0 left-0 h-full w-0 bg-[var(--color-accent)]\" data-kid=\"47\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"min-h-screen pt-48 pb-12 px-6 md:px-12 flex flex-col justify-between relative overflow-hidden\" data-kid=\"48\">\n        <div class=\"absolute bottom-20 -left-16 text-[50vw] font-anton text-black/[0.025] select-none leading-none -z-10 pointer-events-none\" data-kid=\"49\">04</div>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-12 border-t border-black pt-12 items-end\" data-kid=\"50\">\n            <div class=\"col-span-1\" data-kid=\"51\">\n                <p class=\"text-[10px] uppercase opacity-40 font-bold mb-4 tracking-[0.2em]\" data-kid=\"52\">Contact / Inquiries</p>\n                <div class=\"flex flex-col space-y-2\" data-kid=\"53\">\n                    <button onclick=\"copyEmail()\" class=\"font-anton text-3xl md:text-4xl uppercase hover:text-[var(--color-accent)] transition-colors cursor-pointer text-left group\" data-kid=\"54\">\n                        hello@swiss.studio\n                        <span id=\"copy-feedback\" class=\"block text-[10px] opacity-0 group-hover:opacity-100 transition-opacity font-space font-bold mt-1\" data-kid=\"55\">Click to copy</span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"col-span-1\" data-kid=\"56\">\n                <p class=\"text-xs uppercase opacity-40 font-bold mb-4 tracking-widest\" data-kid=\"57\">Connect</p>\n                <div class=\"flex flex-col space-y-2\" data-kid=\"58\">\n                    <a href=\"#\" class=\"uppercase font-bold hover:underline\" data-kid=\"59\">Instagram</a>\n                    <a href=\"#\" class=\"uppercase font-bold hover:underline\" data-kid=\"60\">Twitter / X</a>\n                    <a href=\"#\" class=\"uppercase font-bold hover:underline\" data-kid=\"61\">LinkedIn</a>\n                </div>\n            </div>\n            <div class=\"col-span-1\" data-kid=\"62\">\n                <p class=\"text-xs uppercase opacity-40 font-bold mb-4 tracking-widest\" data-kid=\"63\">Local Time (CH)</p>\n                <p class=\"text-3xl md:text-4xl font-anton uppercase\" id=\"local-time\" data-kid=\"64\">00:00:00</p>\n            </div>\n            <div class=\"col-span-1 text-right md:block hidden\" data-kid=\"65\">\n                <p class=\"text-xs uppercase opacity-40 font-bold mb-4 tracking-widest\" data-kid=\"66\">Availability</p>\n                <p class=\"font-bold text-[#FF3800] uppercase animate-pulse\" data-kid=\"67\">Now Booking Q3 2024</p>\n            </div>\n        </div>\n\n        <div class=\"mt-48 flex flex-col md:flex-row justify-between items-end md:items-center\" data-kid=\"68\">\n            <h2 class=\"font-anton text-[10vw] leading-[0.85] uppercase tracking-tighter hover:text-[var(--color-accent)] cursor-pointer transition-colors duration-500\" data-kid=\"69\">LET'S TALK</h2>\n            <div class=\"flex items-center gap-8 mt-12 md:mt-0\" data-kid=\"70\">\n                <div class=\"text-right\" data-kid=\"71\">\n                    <p class=\"text-[10px] uppercase font-bold opacity-30\" data-kid=\"72\">©2024 Redacted Swiss Studio</p>\n                    <p class=\"text-[10px] uppercase font-bold opacity-30\" data-kid=\"73\">All Rights Reserved</p>\n                </div>\n                <div class=\"w-16 h-16 bg-black flex items-center justify-center rounded-full text-white hover:bg-[var(--color-accent)] transition-colors cursor-pointer group\" data-kid=\"74\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"group-hover:-rotate-45 transition-transform duration-300\" data-kid=\"75\"><line x1=\"7\" y1=\"17\" x2=\"17\" y2=\"7\" data-kid=\"76\"></line><polyline points=\"7 7 17 7 17 17\" data-kid=\"77\"></polyline></svg>\n                </div>\n            </div>\n        </div>\n    </footer>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"78\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"79\"></script>\n<script type=\"module\" data-kid=\"80\">\n    import { animate, spring, inView, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // 1. Custom Magnetic Cursor Logic\n    const cursor = document.querySelector('#magnetic-cursor');\n    const cursorInner = cursor.querySelector('.dot');\n    \n    window.addEventListener('mousemove', (e) => {\n        animate(cursor, { \n            x: e.clientX - 55, \n            y: e.clientY - 55 \n        }, { \n            type: \"spring\", \n            stiffness: 400, \n            damping: 30,\n            mass: 0.2\n        });\n        \n        // Inner dot slight lag\n        animate(cursorInner, {\n            x: (e.movementX || 0) * 0.5,\n            y: (e.movementY || 0) * 0.5\n        }, { type: \"spring\", stiffness: 1000, damping: 50 });\n    });\n\n    // Cursor Hover Interactions\n    const interactiveElements = document.querySelectorAll('a, button, .project-item, h2, .cursor-pointer');\n    interactiveElements.forEach(el => {\n        el.addEventListener('mouseenter', () => {\n            animate(cursor, { \n                scale: 1.5,\n                borderColor: '#FF3800'\n            }, { duration: 0.3 });\n        });\n        el.addEventListener('mouseleave', () => {\n            animate(cursor, { \n                scale: 1,\n                borderColor: '#FF3800'\n            }, { duration: 0.3 });\n        });\n    });\n\n    // 2. Hero Reveal Animation (GSAP)\n    const heroTitle = document.querySelectorAll('#hero-title .reveal-text span');\n    gsap.from(heroTitle, {\n        y: \"100%\",\n        duration: 1.4,\n        ease: \"expo.out\",\n        stagger: 0.15,\n        delay: 0.5\n    });\n\n    // 3. Project Hover Preview Follow Pointer (Motion.dev)\n    const hoverPreview = document.querySelector('#hover-preview');\n    const previewImg = hoverPreview.querySelector('img');\n    const projectItems = document.querySelectorAll('.project-item');\n\n    projectItems.forEach(item => {\n        item.addEventListener('mouseenter', () => {\n            const newImg = item.getAttribute('data-img');\n            previewImg.src = newImg;\n            animate(hoverPreview, { opacity: 1, scale: 1 }, { duration: 0.4, ease: \"easeOut\" });\n        });\n        item.addEventListener('mouseleave', () => {\n            animate(hoverPreview, { opacity: 0, scale: 0.8 }, { duration: 0.4, ease: \"easeIn\" });\n        });\n    });\n\n    window.addEventListener('mousemove', (e) => {\n        animate(hoverPreview, {\n            x: e.clientX + 40,\n            y: e.clientY - 280\n        }, { type: \"spring\", stiffness: 200, damping: 20 });\n    });\n\n    // 4. Asterisk Rotation\n    animate(\"#asterisk-container img\", { \n        rotate: 360 \n    }, { \n        duration: 20, \n        repeat: Infinity, \n        ease: \"linear\" \n    });\n\n    // 5. Manifesto Scroll Animation\n    inView(\"#manifesto-text\", (el) => {\n        gsap.from(el, {\n            opacity: 0,\n            y: 30,\n            duration: 0.8,\n            ease: \"power2.out\"\n        });\n    });\n\n    scroll(animate(\"#manifesto-progress\", { width: \"100%\" }), {\n        target: document.querySelector(\"#manifesto-text\"),\n        offset: [\"start end\", \"center center\"]\n    });\n\n    window.copyEmail = () => {\n        navigator.clipboard.writeText('hello@swiss.studio');\n        const feedback = document.getElementById('copy-feedback');\n        feedback.innerText = 'Email Copied';\n        feedback.style.opacity = '1';\n        feedback.style.color = '#FF3800';\n        setTimeout(() => {\n            feedback.innerText = 'Click to copy';\n            feedback.style.opacity = '';\n            feedback.style.color = '';\n        }, 2000);\n    };\n\n    // 6. Project List Reveal\n    inView(\"#project-list\", (el) => {\n        gsap.from(\".project-item\", {\n            opacity: 0,\n            y: 100,\n            duration: 1,\n            stagger: 0.2,\n            ease: \"power3.out\",\n            scrollTrigger: {\n                trigger: el,\n                start: \"top 80%\"\n            }\n        });\n    });\n\n    // 7. Footer Clock\n    function updateClock() {\n        const now = new Date();\n        const clockEl = document.getElementById('local-time');\n        if(clockEl) {\n            clockEl.innerText = now.toLocaleTimeString('en-US', { hour12: false });\n        }\n    }\n    setInterval(updateClock, 1000);\n    updateClock();\n\n    // 8. Magnetic Buttons (Extra Polish)\n    document.querySelectorAll('.magnetic-target').forEach(btn => {\n        btn.addEventListener('mousemove', (e) => {\n            const rect = btn.getBoundingClientRect();\n            const x = e.clientX - rect.left - rect.width / 2;\n            const y = e.clientY - rect.top - rect.height / 2;\n            animate(btn, { x: x * 0.3, y: y * 0.3 }, { duration: 0.1 });\n        });\n        btn.addEventListener('mouseleave', () => {\n            animate(btn, { x: 0, y: 0 }, { type: \"spring\" });\n        });\n    });\n\n</script>\n",
      "comments": [],
      "created": "2026-06-15T17:47:10.868882+00:00",
      "modified": "2026-06-15T17:47:10.868882+00:00",
