      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Sans:wght@300;400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --color-bg: #0014A8;\n        --color-text: #7DF9FF;\n        --color-accent: #FF0090;\n    }\n\n    body {\n        background-color: var(--color-bg);\n        color: var(--color-text);\n        font-family: 'Fira Sans', sans-serif;\n        overflow-x: clip;\n    }\n\n    .font-heading {\n        font-family: 'Space Grotesk', sans-serif;\n    }\n\n    .glass {\n        background: rgba(0, 20, 168, 0.4);\n        backdrop-filter: blur(24px) saturate(150%);\n        -webkit-backdrop-filter: blur(24px) saturate(150%);\n        border: 1px solid rgba(125, 249, 255, 0.1);\n        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);\n    }\n\n    .glass-accent {\n        border-color: rgba(255, 0, 144, 0.4);\n        box-shadow: inset 0 0 15px rgba(255, 0, 144, 0.05);\n    }\n\n    .border-tech {\n        border-image: linear-gradient(to bottom right, var(--color-text), transparent) 1;\n        border-width: 1px;\n    }\n\n    .scanline {\n        background: linear-gradient(\n            to bottom,\n            rgba(255, 255, 255, 0) 50%,\n            rgba(255, 255, 255, 0.02) 50%\n        );\n        background-size: 100% 4px;\n        pointer-events: none;\n    }\n\n    .noise {\n        position: fixed;\n        inset: -200%;\n        background-image: url('https://www.transparenttextures.com/patterns/p6.png');\n        opacity: 0.08;\n        pointer-events: none;\n        z-index: 100;\n        animation: noise-move 8s steps(10) infinite;\n    }\n\n    @keyframes noise-move {\n        0% { transform: translate(0,0); }\n        10% { transform: translate(-5%,-5%); }\n        20% { transform: translate(-10%,5%); }\n        30% { transform: translate(5%,-10%); }\n        40% { transform: translate(-5%,15%); }\n        50% { transform: translate(-10%,5%); }\n        60% { transform: translate(15%,0); }\n        70% { transform: translate(0,10%); }\n        80% { transform: translate(-15%,0); }\n        90% { transform: translate(10%,5%); }\n        100% { transform: translate(5%,0); }\n    }\n\n    .custom-cursor {\n        width: 20px;\n        height: 20px;\n        border: 2px solid var(--color-text);\n        border-radius: 50%;\n        position: fixed;\n        pointer-events: none;\n        z-index: 9999;\n        mix-blend-mode: difference;\n    }\n\n    /* Hide standard scrollbar */\n    ::-webkit-scrollbar {\n        width: 4px;\n    }\n    ::-webkit-scrollbar-track {\n        background: var(--color-bg);\n    }\n    ::-webkit-scrollbar-thumb {\n        background: var(--color-accent);\n        border-radius: 10px;\n    }\n\n    #orbit-container {\n        perspective: 1000px;\n    }\n\n    .terminal-cursor {\n        display: inline-block;\n        width: 8px;\n        height: 18px;\n        background-color: var(--color-text);\n        vertical-align: middle;\n        margin-left: 4px;\n    }\n\n    .hover-reveal-img {\n        clip-path: inset(0 100% 0 0);\n    }\n</style>\n\n<div class=\"custom-cursor\" data-kid=\"1\"></div>\n<div class=\"noise\" data-kid=\"2\"></div>\n\n\n<section id=\"hero\" class=\"relative h-screen flex items-center justify-center overflow-hidden\" data-kid=\"3\">\n    <video src=\"https://videos.pexels.com/video-files/11749941/11749941-sd_426_226_30fps.mp4\" poster=\"https://images.pexels.com/videos/11749941/abstract-acrylic-art-artistic-11749941.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline class=\"absolute inset-0 w-full h-full object-cover opacity-60 pointer-events-none\" data-kid=\"4\"></video>\n    \n    <div class=\"absolute inset-0 bg-gradient-to-b from-transparent to-[var(--color-bg)]\" data-kid=\"5\"></div>\n\n    <div class=\"absolute inset-0 scanline z-5\" data-kid=\"6\"></div>\n\n    <div class=\"relative z-10 w-full max-w-7xl px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"7\">\n        <div class=\"lg:col-span-8 flex flex-col gap-6\" data-kid=\"8\">\n            <div id=\"hero-panel-1\" class=\"glass p-8 lg:p-16 rounded-sm max-w-3xl border-l-2 border-l-[var(--color-text)] relative overflow-hidden\" data-kid=\"9\">\n                <div class=\"absolute top-0 right-0 p-4 font-mono text-[10px] opacity-20\" data-kid=\"10\">REF_ID: 0x88F2</div>\n                <div class=\"flex items-center gap-3 mb-6\" data-kid=\"11\">\n                    <div class=\"w-2 h-2 bg-[var(--color-accent)] animate-pulse\" data-kid=\"12\"></div>\n                    <span class=\"font-mono text-xs tracking-[0.4em] opacity-50\" data-kid=\"13\">CONNECTION_SECURE</span>\n                </div>\n                <h1 class=\"font-heading text-7xl md:text-9xl font-bold tracking-tighter text-[var(--color-text)] mb-8 leading-[0.85] drop-shadow-[0_0_15px_rgba(125,249,255,0.3)]\" data-kid=\"14\">\n                    NEON.<br data-kid=\"15\"><span class=\"text-[var(--color-accent)] drop-shadow-[0_0_15px_rgba(255,0,144,0.3)]\" data-kid=\"16\">ABYSS</span>\n                </h1>\n                <p class=\"text-xl md:text-2xl text-[var(--color-text)]/90 max-w-xl leading-relaxed font-light border-t border-white/5 pt-8\" data-kid=\"17\">\n                    High-precision WebGL experimentation at the edge of the void.\n                </p>\n            </div>\n            \n            <div id=\"hero-panel-2\" class=\"glass glass-accent px-8 py-4 rounded-sm w-fit self-start border-r-2 border-r-[var(--color-accent)]\" data-kid=\"18\">\n                <span class=\"font-mono text-xs tracking-[0.4em] text-[var(--color-accent)] uppercase flex items-center gap-3\" data-kid=\"19\">\n                    <i class=\"ti ti-binary\" data-kid=\"20\"></i>\n              