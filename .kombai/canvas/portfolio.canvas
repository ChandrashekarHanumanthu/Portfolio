      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;200;400;700;800;900&family=Fira+Code:wght@300;400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-primary: #7c3aed;\n    --color-secondary: #c026d3;\n    --color-bg: #000000;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: #ffffff;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'Fira+Code', monospace; }\n  \n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .text-glow {\n    text-shadow: 0 0 20px rgba(124, 58, 237, 0.5);\n  }\n\n  .light-leak {\n    background: linear-gradient(to top, rgba(192, 38, 211, 0.2), transparent);\n  }\n\n  .hairline {\n    border: 0.5px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .corner-nav-line-h {\n    height: 0.5px;\n    background: rgba(255, 255, 255, 0.1);\n    position: fixed;\n    left: 2rem;\n    right: 2rem;\n    z-index: 50;\n  }\n\n  .corner-nav-line-v {\n    width: 0.5px;\n    background: rgba(255, 255, 255, 0.1);\n    position: fixed;\n    top: 2rem;\n    bottom: 2rem;\n    z-index: 50;\n  }\n\n  .skill-node {\n    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  .skill-node:hover {\n    box-shadow: 0 0 15px rgba(124, 58, 237, 0.6);\n    border-color: rgba(124, 58, 237, 0.8);\n    transform: scale(1.1);\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"corner-nav-line-h top-8\" data-kid=\"2\"></div>\n  <div class=\"corner-nav-line-h bottom-8\" data-kid=\"3\"></div>\n  <div class=\"corner-nav-line-v left-8\" data-kid=\"4\"></div>\n  <div class=\"corner-nav-line-v right-8\" data-kid=\"5\"></div>\n\n  \n  <div class=\"fixed top-12 left-12 z-50 mix-blend-difference\" data-kid=\"6\">\n    <span class=\"font-mono text-xs tracking-[0.4em] uppercase opacity-60\" data-kid=\"7\">Chandrashekar H.</span>\n  </div>\n  <div class=\"fixed top-12 right-12 z-50 mix-blend-difference\" data-kid=\"8\">\n    <nav class=\"flex gap-8\" data-kid=\"9\">\n      <a href=\"#about\" class=\"font-mono text-xs tracking-[0.2em] uppercase hover:text-primary transition-colors\" data-kid=\"10\">About</a>\n      <a href=\"#projects\" class=\"font-mono text-xs tracking-[0.2em] uppercase hover:text-primary transition-colors\" data-kid=\"11\">Work</a>\n    </nav>\n  </div>\n  <div class=\"fixed bottom-12 left-12 z-50 mix-blend-difference\" data-kid=\"12\">\n    <div class=\"flex gap-6\" data-kid=\"13\">\n      <a href=\"#\" class=\"opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"14\"><i class=\"ti ti-brand-github text-lg\" data-kid=\"15\"></i></a>\n      <a href=\"#\" class=\"opacity-50 hover:opacity-100 transition-opacity\" data-kid=\"16\"><i class=\"ti ti-brand-linkedin text-lg\" data-kid=\"17\"></i></a>\n    </div>\n  </div>\n  <div class=\"fixed bottom-12 right-12 z-50 mix-blend-difference\" data-kid=\"18\">\n    <a href=\"mailto:hello@example.com\" class=\"font-mono text-xs tracking-[0.2em] uppercase hover:text-primary transition-colors\" data-kid=\"19\">Contact</a>\n  </div>\n\n  \n  <section class=\"relative h-screen flex items-center justify-center overflow-hidden\" data-kid=\"20\">\n    <video src=\"https://videos.pexels.com/video-files/6071387/6071387-uhd_2560_1440_30fps.mp4\" poster=\"https://images.pexels.com/videos/6071387/pexels-photo-6071387.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline class=\"absolute inset-0 w-full h-full object-cover opacity-40 scale-105\" style=\"filter: brightness(0.7) contrast(1.2);\" preload=\"metadata\" data-kid=\"21\"></video>\n    \n    <div class=\"relative z-10 text-center px-6\" data-kid=\"22\">\n      <h1 class=\"hero-title text-6xl md:text-8xl font-thin tracking-[0.15em] leading-tight opacity-0 translate-y-8\" data-kid=\"23\">\n        Crafting digital <br data-kid=\"24\">\n        <span class=\"font-light italic\" data-kid=\"25\">experiences.</span>\n      </h1>\n      <p class=\"hero-subtitle font-mono text-sm tracking-[0.5em] uppercase opacity-0 mt-8 text-white/40\" data-kid=\"26\">\n        Full Stack Web Developer\n      </p>\n    </div>\n\n    \n    <div class=\"absolute bottom-16 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-30\" data-kid=\"27\">\n      <span class=\"font-mono text-[10px] tracking-[0.3em] uppercase\" data-kid=\"28\">Scroll</span>\n      <div class=\"w-px h-12 bg-gradient-to-b from-white to-transparent\" data-kid=\"29\"></div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"relative py-32 px-12 md:px-24\" data-kid=\"30\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-16 items-start\" data-kid=\"31\">\n      <div class=\"md:col-span-5 relative group\" data-kid=\"32\">\n        <div class=\"absolute -inset-4 bg-primary/20 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-1000\" data-kid=\"33\"></div>\n        <img src=\"https://images.unsplash.com/photo-1624224527548-476046912f7e?auto=format&w=800&q=80&fit=crop\" alt=\"Chandrashekar\" class=\"relative w-full aspect-[4/5] object-cover grayscale brightness-75 contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"34\">\n        <div class=\"absolute inset-0 border border-white/10 -m-4 translate-x-4 translate-y-4 -z-10\" data-kid=\"35\"></div>\n      </div>\n      \n      <div class=\"md:col-span-7 pt-12\" data-kid=\"36\">\n        <span class=\"font-mono text-xs text-primary tracking-[0.3em] uppercase mb-6 block\" data-kid=\"37\">01 / About Me</span>\n        <h2 class=\"text-4xl md:text-5xl font-extralight tracking-tight leading-snug mb-8\" data-kid=\"38\">\n          <span class=\"text-6xl float-left mr-4 leading-[0.8] font-bold text-white/20\" data-kid=\"39\">I</span>\n          blend technical precision with creative problem solving to build scalable, high-performance web applications.\n        </h2>\n        <div class=\"max-w-lg space-y-6 text-white/50 leading-relaxed font-light\" data-kid=\"40\">\n          <p data-kid=\"41\">Currently at Kapil Technologies, I specialize in the Java ecosystem, crafting robust backend solutions with Spring Boot while delivering seamless frontend interfaces using React.</p>\n          <p data-kid=\"42\">My approach is rooted in clean code principles and a deep understanding of full-stack architecture, from database optimization to fluid UI animations.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-32 bg-slate-950/50\" data-kid=\"43\">\n    <div class=\"absolute inset-0 opacity-10\" style=\"background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;\" data-kid=\"44\"></div>\n    \n    <div class=\"max-w-5xl mx-auto px-12 text-center relative z-10\" data-kid=\"45\">\n      <span class=\"font-mono text-xs text-secondary tracking-[0.3em] uppercase mb-12 block\" data-kid=\"46\">02 / Technical Stack</span>\n      \n      <div id=\"skills-constellation\" class=\"relative h-[500px] w-full mt-16\" data-kid=\"47\">\n        <svg id=\"skill-lines\" class=\"absolute inset-0 w-full h-full pointer-events-none opacity-20\" data-kid=\"48\"></svg>\n        \n        \n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"20\" data-y=\"30\" data-kid=\"49\">Java</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"45\" data-y=\"15\" data-kid=\"50\">Spring Boot</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"70\" data-y=\"40\" data-kid=\"51\">React.js</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"35\" data-y=\"65\" data-kid=\"52\">Node.js</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"80\" data-y=\"75\" data-kid=\"53\">MySQL</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"15\" data-y=\"75\" data-kid=\"54\">Tailwind</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"55\" data-y=\"85\" data-kid=\"55\">PostgreSQL</div>\n        <div class=\"skill-node absolute glass px-6 py-3 rounded-full font-mono text-xs tracking-widest cursor-default\" data-x=\"85\" data-y=\"20\" data-kid=\"56\">Python</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"relative\" data-kid=\"57\">\n    <div class=\"max-w-7xl mx-auto px-12 py-32\" data-kid=\"58\">\n       <span class=\"font-mono text-xs text-white/30 tracking-[0.3em] uppercase mb-24 block\" data-kid=\"59\">03 / Selected Work</span>\n       \n       <div class=\"space-y-64\" data-kid=\"60\">\n         \n         <div class=\"project-item flex flex-col md:flex-row items-center gap-16 sticky top-32 bg-black py-16\" data-kid=\"61\">\n           <div class=\"w-full md:w-1/2 aspect-video overflow-hidden glass relative group\" data-kid=\"62\">\n             <img src=\"https://images.unsplash.com/photo-1761998066489-4f32b9a4dff8?auto=format&w=1200&q=80&fit=crop\" alt=\"Odoo CRM\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"63\">\n             <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-60\" data-kid=\"64\"></div>\n           </div>\n           <div class=\"w-full md:w-1/2\" data-kid=\"65\">\n             <h3 class=\"text-4xl font-thin tracking-tight mb-4\" data-kid=\"66\">Odoo CRM <br data-kid=\"67\"><span class=\"text-xl text-white/40\" data-kid=\"68\">Customization</span></h3>\n             <p class=\"font-light text-white/50 mb-8 max-w-sm\" data-kid=\"69\">Enhanced dashboard modules and workflow automation for enterprise CRM systems.</p>\n             <div class=\"flex gap-4 font-mono text-[10px] tracking-widest opacity-40 uppercase\" data-kid=\"70\">\n               <span data-kid=\"71\">Python</span>\n               <span data-kid=\"72\">•</span>\n               <span data-kid=\"73\">PostgreSQL</span>\n               <span data-kid=\"74\">•</span>\n               <span data-kid=\"75\">XML</span>\n             </div>\n           </div>\n         </div>\n\n         \n         <div class=\"project-item flex flex-col md:flex-row-reverse items-center gap-16 sticky top-32 bg-black py-16\" data-kid=\"76\">\n           <div class=\"w-full md:w-1/2 aspect-video overflow-hidden glass relative group\" data-kid=\"77\">\n             <img src=\"https://images.unsplash.com/photo-1702479743967-3dcccd4a671d?auto=format&w=1200&q=80&fit=crop\" alt=\"PTKCS Portal\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"78\">\n             <div class=\"absolute inset-0 bg-gradient-to-t from-black to-transparent opacity-60\" data-kid=\"79\"></div>\n           </div>\n           <div class=\"w-full md:w-1/2\" data-kid=\"80\">\n             <h3 class=\"text-4xl font-thin tracking-tight mb-4\" data-kid=\"81\">PTKCS <br data-kid=\"82\"><span class=\"text-xl text-white/40\" data-kid=\"83\">Corporate Portal</span></h3>\n             <p class=\"font-light text-white/50 mb-8 max-w-sm\" data-kid=\"84\">A unified platform for managing enterprise technical certifications and employee tracking.</p>\n             <div class=\"flex gap-4 font-mono text-[10px] tracking-widest opacity-40 uppercase\" data-kid=\"85\">\n               <span data-kid=\"86\">React</span>\n               <span data-kid=\"87\">•</span>\n               <span data-kid=\"88\">Node.js</span>\n               <span data-kid=\"89\">•</span>\n               <span data-kid=\"90\">MongoDB</span>\n             </div>\n           </div>\n         </div>\n       </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"relative h-screen flex flex-col items-center justify-center bg-black overflow-hidden\" data-kid=\"91\">\n    \n    <div class=\"absolute bottom-0 left-0 right-0 h-96 light-leak opacity-40\" data-kid=\"92\"></div>\n    <div class=\"absolute -bottom-24 left-1/2 -translate-x-1/2 w-[800px] h-64 bg-primary/20 blur-[120px] rounded-full\" data-kid=\"93\"></div>\n\n    <div class=\"relative z-10 text-center space-y-12\" data-kid=\"94\">\n      <h2 class=\"text-5xl md:text-7xl font-thin tracking-[0.2em] mb-12\" data-kid=\"95\">Let's build.</h2>\n      \n      <a href=\"#\" class=\"inline-flex items-center gap-4 glass px-12 py-5 rounded-full font-mono text-xs tracking-[0.4em] uppercase hover:bg-white/10 transition-all group overflow-hidden relative\" data-kid=\"96\">\n        <span class=\"relative z-10\" data-kid=\"97\">Download Resume</span>\n        <i class=\"ti ti-download relative z-10 transition-transform group-hover:translate-y-1\" data-kid=\"98\"></i>\n        <div class=\"absolute inset-0 bg-gradient-to-r from-primary/20 to-secondary/20 opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"99\"></div>\n      </a>\n\n      <div class=\"flex gap-12 pt-24\" data-kid=\"100\">\n        <div class=\"text-left\" data-kid=\"101\">\n          <span class=\"font-mono text-[10px] tracking-widest opacity-30 uppercase block mb-2\" data-kid=\"102\">Email</span>\n          <a href=\"#\" class=\"text-sm font-light hover:text-primary transition-colors\" data-kid=\"103\">hello@chandrashekar.dev</a>\n        </div>\n        <div class=\"text-left\" data-kid=\"104\">\n          <span class=\"font-mono text-[10px] tracking-widest opacity-30 uppercase block mb-2\" data-kid=\"105\">Location</span>\n          <p class=\"text-sm font-light\" data-kid=\"106\">Hyderabad, India</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"absolute bottom-12 w-full px-12 flex justify-between items-end opacity-20 font-mono text-[10px] tracking-[0.3em] uppercase\" data-kid=\"107\">\n      <span data-kid=\"108\">© 2024</span>\n      <span data-kid=\"109\">Engineered with Precision</span>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"110\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"111\"></script>\n<script data-kid=\"112\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Animations\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline({ defaults: { ease: \"power4.out\" }});\n    tl.to(\".hero-title\", { opacity: 1, y: 0, duration: 1.5 })\n      .to(\".hero-subtitle\", { opacity: 1, duration: 1, letterSpacing: \"0.8em\" }, \"-=1\");\n  });\n\n  // Skills Constellation Logic\n  const nodes = document.querySelectorAll('.skill-node');\n  const svg = document.getElementById('skill-lines');\n  \n  function positionNodes() {\n    nodes.forEach(node => {\n      const x = node.getAttribute('data-x');\n      const y = node.getAttribute('data-y');\n      node.style.left = `${x}%`;\n      node.style.top = `${y}%`;\n    });\n  }\n\n  function drawLines() {\n    svg.innerHTML = '';\n    const nodeArray = Array.from(nodes);\n    \n    // Connect each node to 2-3 closest neighbors\n    nodeArray.forEach((node, i) => {\n      const neighbors = nodeArray.slice(i + 1, i + 4);\n      const rect1 = node.getBoundingClientRect();\n      const parentRect = svg.getBoundingClientRect();\n\n      neighbors.forEach(neighbor => {\n        const rect2 = neighbor.getBoundingClientRect();\n        \n        const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n        line.setAttribute(\"x1\", rect1.left - parentRect.left + rect1.width/2);\n        line.setAttribute(\"y1\", rect1.top - parentRect.top + rect1.height/2);\n        line.setAttribute(\"x2\", rect2.left - parentRect.left + rect2.width/2);\n        line.setAttribute(\"y2\", rect2.top - parentRect.top + rect2.height/2);\n        line.setAttribute(\"stroke\", \"white\");\n        line.setAttribute(\"stroke-width\", \"0.5\");\n        line.style.opacity = \"0.3\";\n        svg.appendChild(line);\n      });\n    });\n  }\n\n  positionNodes();\n  window.addEventListener('resize', drawLines);\n  setTimeout(drawLines, 500);\n\n  // Projects Fade Animation on Scroll\n  const projectItems = document.querySelectorAll('.project-item');\n  projectItems.forEach((item, i) => {\n    gsap.from(item, {\n      opacity: 0,\n      y: 100,\n      duration: 1,\n      scrollTrigger: {\n        trigger: item,\n        start: \"top 80%\",\n        end: \"top 20%\",\n        scrub: 1,\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n\n  // Footer Light Pulse\n  gsap.to(\".light-leak\", {\n    opacity: 0.2,\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n</script>",
