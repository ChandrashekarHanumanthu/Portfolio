      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@300;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --bg-color: #010B13;\n        --text-color: #F2F3F4;\n        --accent-color: #8F00FF;\n        --font-heading: 'Inter', sans-serif;\n        --font-body: 'DM Sans', sans-serif;\n        --font-mono: 'Space Grotesk', monospace;\n    }\n\n    body {\n        margin: 0;\n        background-color: #010B13;\n        color: #F2F3F4;\n        font-family: 'DM Sans', sans-serif;\n        overflow-x: clip;\n    }\n\n    .portfolio-wrapper {\n        background-color: var(--bg-color);\n    }\n\n    .font-heading { font-family: var(--font-heading); }\n    .font-mono { font-family: var(--font-mono); }\n    \n    #progress-container {\n        position: fixed;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 2px;\n        z-index: 1000;\n        background: rgba(255,255,255,0.05);\n    }\n    #progress-bar {\n        height: 100%;\n        width: 0%;\n        background: var(--accent-color);\n        box-shadow: 0 0 10px var(--accent-color);\n    }\n\n    .gsap-target {\n        transition: none !important;\n    }\n\n    .phrase-mask {\n        background-color: #010B13;\n        padding-top: 0.5rem;\n        padding-bottom: 0.5rem;\n        box-shadow: 0 0 40px 20px #010B13;\n    }\n\n    .experience-line {\n        position: absolute;\n        left: 50%;\n        top: 0;\n        bottom: 0;\n        width: 1px;\n        background: linear-gradient(to bottom, transparent, rgba(143,0,255,0.3), transparent);\n    }\n\n    .skill-tag {\n        background: rgba(255, 255, 255, 0.03);\n        border: 1px solid rgba(255, 255, 255, 0.08);\n        backdrop-blur: 10px;\n    }\n</style>\n\n<div class=\"portfolio-wrapper bg-[#010B13]\" data-kid=\"1\">\n    <div id=\"progress-container\" data-kid=\"2\">\n        <div id=\"progress-bar\" data-kid=\"3\"></div>\n    </div>\n\n    \n    <section id=\"hero\" class=\"relative bg-[#010B13] overflow-clip\" data-kid=\"4\">\n        <div id=\"hero-pin\" class=\"h-[200vh]\" data-kid=\"5\">\n            <div class=\"sticky top-0 h-screen flex items-center justify-center overflow-hidden\" data-kid=\"6\">\n                <div id=\"hero-text-wrapper\" class=\"absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0\" data-kid=\"7\">\n                    <h1 id=\"hero-title\" class=\"gsap-target font-heading font-black text-[12vw] opacity-20 whitespace-nowrap leading-none tracking-tighter\" data-kid=\"8\">\n                        CHANDRASHEKAR\n                    </h1>\n                </div>\n                \n                <div id=\"orb-outer\" class=\"relative z-10 w-64 md:w-96 aspect-square rounded-full overflow-hidden shadow-[0_0_80px_rgba(143,0,255,0.25)] border border-white/15\" data-kid=\"9\">\n                    <img src=\"https://images.unsplash.com/photo-1598056036946-3cfa8493bfdf?auto=format&w=800&q=80&fit=crop\" alt=\"3D Glass Orb\" class=\"gsap-target w-full h-full object-cover scale-110 brightness-125 contrast-110\" id=\"hero-orb\" decoding=\"async\" loading=\"lazy\" data-kid=\"10\">\n                </div>\n\n                <nav class=\"absolute top-8 left-8 right-8 flex justify-between items-center z-50\" data-kid=\"11\">\n                    <div class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"12\">CHANDRASHEKAR / 2025</div>\n                    <div class=\"flex gap-8\" data-kid=\"13\">\n                        <a href=\"#about\" class=\"text-[10px] uppercase tracking-widest font-bold hover:text-[#8F00FF] transition-colors\" data-kid=\"14\">About</a>\n                        <a href=\"#experience\" class=\"text-[10px] uppercase tracking-widest font-bold hover:text-[#8F00FF] transition-colors\" data-kid=\"15\">Experience</a>\n                        <a href=\"#works\" class=\"text-[10px] uppercase tracking-widest font-bold hover:text-[#8F00FF] transition-colors\" data-kid=\"16\">Works</a>\n                        <a href=\"#footer\" class=\"text-[10px] uppercase tracking-widest font-bold hover:text-[#8F00FF] transition-colors\" data-kid=\"17\">Contact</a>\n                    </div>\n                </nav>\n                \n                <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-40\" data-kid=\"18\">\n                    <span class=\"text-[10px] uppercase tracking-[0.5em] font-medium text-center\" data-kid=\"19\">Full Stack Developer @ Kapil Technologies</span>\n                    <div class=\"w-[1px] h-16 bg-gradient-to-b from-white to-transparent\" data-kid=\"20\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"narrative\" class=\"relative bg-[#010B13] border-t border-white/5\" data-kid=\"21\">\n        <div id=\"narrative-pin\" class=\"h-[250vh]\" data-kid=\"22\">\n            <div class=\"sticky top-0 h-screen flex flex-col items-center justify-center overflow-hidden\" data-kid=\"23\">\n                <div class=\"absolute h-full flex flex-col items-center justify-center\" data-kid=\"24\">\n                    <div class=\"w-[1px] h-full bg-white/10 relative\" data-kid=\"25\">\n                        <div id=\"narrative-filler\" class=\"gsap-target absolute top-0 left-0 w-full h-0 bg-[#8F00FF] shadow-[0_0_15px_#8F00FF]\" data-kid=\"26\"></div>\n                    </div>\n                </div>\n                <div class=\"relative z-20 text-center px-6\" data-kid=\"27\">\n                    <div class=\"h-32 flex items-center justify-center relative\" data-kid=\"28\">\n                        <h2 class=\"phrase-1 phrase-mask gsap-target font-heading font-bold text-3xl md:text-6xl tracking-tighter absolute px-8 w-full max-w-4xl\" data-kid=\"29\">\n                            Engineering <span class=\"text-[#8F00FF]\" data-kid=\"30\">enterprise-grade</span> ecosystems.\n                        </h2>\n                        <h2 class=\"phrase-2 phrase-mask gsap-target font-heading font-bold text-3xl md:text-6xl tracking-tighter absolute opacity-0 px-8 w-full max-w-4xl\" data-kid=\"31\">\n                            Bridging Java robustness with <span class=\"text-[#8F00FF]\" data-kid=\"32\">React</span> agility.\n                        </h2>\n                        <h2 class=\"phrase-3 phrase-mask gsap-target font-heading font-bold text-3xl md:text-6xl tracking-tighter absolute opacity-0 px-8 w-full max-w-4xl\" data-kid=\"33\">\n                            Defining the <span class=\"text-[#8F00FF]\" data-kid=\"34\">full-stack</span> standard.\n                        </h2>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"about\" class=\"py-32 px-8 bg-[#010B13] relative overflow-hidden\" data-kid=\"35\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"36\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-24 items-center\" data-kid=\"37\">\n                <div class=\"gsap-reveal-about\" data-kid=\"38\">\n                    <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-6 block uppercase\" data-kid=\"39\">Profile / 01</span>\n                    <h2 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter mb-12\" data-kid=\"40\">I design systems that <span class=\"opacity-40 italic\" data-kid=\"41\">scale.</span></h2>\n                    <div class=\"space-y-6 text-xl text-white/70 leading-relaxed max-w-2xl\" data-kid=\"42\">\n                        <p data-kid=\"43\">I'm a passionate <span class=\"text-white font-medium\" data-kid=\"44\">Full Stack Web Developer</span> with expertise in <span class=\"text-[#8F00FF]\" data-kid=\"45\">Java, Spring Boot, React, and MySQL</span>. Currently at <span class=\"text-white\" data-kid=\"46\">Kapil Technologies</span>, I focus on delivering responsive UIs, integrating APIs, and building scalable backend services.</p>\n                        <p data-kid=\"47\">My journey spans from Odoo ERP customization to building deep-learning facial recognition models, giving me a diverse perspective on technical challenges.</p>\n                    </div>\n                    <div class=\"mt-12 flex gap-8\" data-kid=\"48\">\n                        <div data-kid=\"49\">\n                            <div class=\"text-[10px] uppercase tracking-widest text-white/40 mb-2\" data-kid=\"50\">Location</div>\n                            <div class=\"font-bold\" data-kid=\"51\">Hyderabad, IN</div>\n                        </div>\n                        <div data-kid=\"52\">\n                            <div class=\"text-[10px] uppercase tracking-widest text-white/40 mb-2\" data-kid=\"53\">Role</div>\n                            <div class=\"font-bold\" data-kid=\"54\">Full Stack Dev</div>\n                        </div>\n                        <div data-kid=\"55\">\n                            <div class=\"text-[10px] uppercase tracking-widest text-white/40 mb-2\" data-kid=\"56\">Stack</div>\n                            <div class=\"font-bold\" data-kid=\"57\">Java / React / Python</div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative gsap-reveal-about-img\" data-kid=\"58\">\n                    <div class=\"aspect-square bg-white/5 border border-white/10 rounded-2xl flex items-center justify-center relative overflow-hidden group\" data-kid=\"59\">\n                        <span class=\"text-9xl grayscale group-hover:grayscale-0 transition-all duration-700\" data-kid=\"60\">👨‍💻</span>\n                        <div class=\"absolute inset-0 bg-gradient-to-tr from-[#8F00FF]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"61\"></div>\n                    </div>\n                    <div class=\"absolute -bottom-8 -right-8 w-48 h-48 border border-[#8F00FF]/30 rounded-2xl -z-10\" data-kid=\"62\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"experience\" class=\"py-32 bg-[#010B13] border-y border-white/5 relative\" data-kid=\"63\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"64\">\n            <div class=\"flex flex-col items-center text-center mb-24\" data-kid=\"65\">\n                <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-4 uppercase\" data-kid=\"66\">Career / 02</span>\n                <h2 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter\" data-kid=\"67\">Professional Journey</h2>\n            </div>\n            \n            <div class=\"relative space-y-24\" data-kid=\"68\">\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-8 md:gap-16 items-center gsap-reveal-exp\" data-kid=\"69\">\n                    <div class=\"text-right hidden md:block\" data-kid=\"70\">\n                        <span class=\"text-white/40 font-mono\" data-kid=\"71\">Jul 2025 — Present</span>\n                    </div>\n                    <div class=\"flex flex-col items-center\" data-kid=\"72\">\n                        <div class=\"w-4 h-4 rounded-full bg-[#8F00FF] shadow-[0_0_15px_#8F00FF]\" data-kid=\"73\"></div>\n                        <div class=\"w-[1px] h-full bg-white/10 mt-4\" data-kid=\"74\"></div>\n                    </div>\n                    <div class=\"bg-white/5 border border-white/10 p-8 rounded-2xl hover:border-[#8F00FF]/50 transition-colors\" data-kid=\"75\">\n                        <span class=\"md:hidden text-white/40 font-mono block mb-4\" data-kid=\"76\">Jul 2025 — Present</span>\n                        <h3 class=\"text-2xl font-bold mb-2\" data-kid=\"77\">Web Developer</h3>\n                        <div class=\"text-[#8F00FF] font-bold mb-6\" data-kid=\"78\">Kapil Technologies</div>\n                        <ul class=\"space-y-3 text-sm text-white/60\" data-kid=\"79\">\n                            <li class=\"flex gap-3\" data-kid=\"80\"><span class=\"text-[#8F00FF]\" data-kid=\"81\">•</span> Developing company portal using React.js and Spring Boot.</li>\n                            <li class=\"flex gap-3\" data-kid=\"82\"><span class=\"text-[#8F00FF]\" data-kid=\"83\">•</span> Building scalable backend services with MySQL optimization.</li>\n                            <li class=\"flex gap-3\" data-kid=\"84\"><span class=\"text-[#8F00FF]\" data-kid=\"85\">•</span> Integrating RESTful APIs for seamless data exchange.</li>\n                        </ul>\n                    </div>\n                </div>\n\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-8 md:gap-16 items-center gsap-reveal-exp\" data-kid=\"86\">\n                    <div class=\"bg-white/5 border border-white/10 p-8 rounded-2xl hover:border-[#8F00FF]/50 transition-colors text-right\" data-kid=\"87\">\n                        <span class=\"md:hidden text-white/40 font-mono block mb-4 text-left\" data-kid=\"88\">May 2025 — Jun 2025</span>\n                        <h3 class=\"text-2xl font-bold mb-2\" data-kid=\"89\">Technical Intern (Odoo)</h3>\n                        <div class=\"text-[#8F00FF] font-bold mb-6\" data-kid=\"90\">Kapil Technologies</div>\n                        <ul class=\"space-y-3 text-sm text-white/60 text-left md:text-right\" data-kid=\"91\">\n                            <li class=\"flex flex-row-reverse gap-3\" data-kid=\"92\">Gained hands-on experience in Odoo, PostgreSQL, and Python. <span class=\"text-[#8F00FF]\" data-kid=\"93\">•</span></li>\n                            <li class=\"flex flex-row-reverse gap-3\" data-kid=\"94\">Customized CRM and Project modules with business logic. <span class=\"text-[#8F00FF]\" data-kid=\"95\">•</span></li>\n                        </ul>\n                    </div>\n                    <div class=\"flex flex-col items-center\" data-kid=\"96\">\n                        <div class=\"w-4 h-4 rounded-full bg-white/20\" data-kid=\"97\"></div>\n                        <div class=\"w-[1px] h-full bg-white/10 mt-4\" data-kid=\"98\"></div>\n                    </div>\n                    <div class=\"text-left hidden md:block\" data-kid=\"99\">\n                        <span class=\"text-white/40 font-mono\" data-kid=\"100\">May 2025 — Jun 2025</span>\n                    </div>\n                </div>\n\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-8 md:gap-16 items-center gsap-reveal-exp\" data-kid=\"101\">\n                    <div class=\"text-right hidden md:block\" data-kid=\"102\">\n                        <span class=\"text-white/40 font-mono\" data-kid=\"103\">Jun 2022 — Aug 2022</span>\n                    </div>\n                    <div class=\"flex flex-col items-center\" data-kid=\"104\">\n                        <div class=\"w-4 h-4 rounded-full bg-white/20\" data-kid=\"105\"></div>\n                    </div>\n                    <div class=\"bg-white/5 border border-white/10 p-8 rounded-2xl hover:border-[#8F00FF]/50 transition-colors\" data-kid=\"106\">\n                        <span class=\"md:hidden text-white/40 font-mono block mb-4\" data-kid=\"107\">Jun 2022 — Aug 2022</span>\n                        <h3 class=\"text-2xl font-bold mb-2\" data-kid=\"108\">Python Developer Intern</h3>\n                        <div class=\"text-[#8F00FF] font-bold mb-6\" data-kid=\"109\">Try Logic Soft Solutions</div>\n                        <p class=\"text-sm text-white/60 leading-relaxed\" data-kid=\"110\">Strengthened coding skills by developing student management systems and core Python applications.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"skills\" class=\"py-32 px-8 bg-[#010B13] relative overflow-hidden\" data-kid=\"111\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"112\">\n            <div class=\"mb-24\" data-kid=\"113\">\n                <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-4 uppercase\" data-kid=\"114\">Stack / 03</span>\n                <h2 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter\" data-kid=\"115\">Tools of the trade.</h2>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12\" data-kid=\"116\">\n                <div class=\"gsap-reveal-skill\" data-kid=\"117\">\n                    <h3 class=\"text-lg font-bold mb-8 flex items-center gap-3\" data-kid=\"118\"><i class=\"ti ti-server text-[#8F00FF]\" data-kid=\"119\"></i> Backend</h3>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"120\">\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"121\">Java</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"122\">Spring Boot</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"123\">Node.js</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"124\">REST APIs</span>\n                    </div>\n                </div>\n                <div class=\"gsap-reveal-skill\" data-kid=\"125\">\n                    <h3 class=\"text-lg font-bold mb-8 flex items-center gap-3\" data-kid=\"126\"><i class=\"ti ti-browser text-[#8F00FF]\" data-kid=\"127\"></i> Frontend</h3>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"128\">\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"129\">React.js</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"130\">JavaScript</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"131\">HTML5 / CSS3</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"132\">Tailwind</span>\n                    </div>\n                </div>\n                <div class=\"gsap-reveal-skill\" data-kid=\"133\">\n                    <h3 class=\"text-lg font-bold mb-8 flex items-center gap-3\" data-kid=\"134\"><i class=\"ti ti-database text-[#8F00FF]\" data-kid=\"135\"></i> Database</h3>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"136\">\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"137\">MySQL</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"138\">PostgreSQL</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"139\">JPA / Hibernate</span>\n                    </div>\n                </div>\n                <div class=\"gsap-reveal-skill\" data-kid=\"140\">\n                    <h3 class=\"text-lg font-bold mb-8 flex items-center gap-3\" data-kid=\"141\"><i class=\"ti ti-settings text-[#8F00FF]\" data-kid=\"142\"></i> Specialist</h3>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"143\">\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"144\">Odoo ERP</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"145\">Python</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"146\">Deep Learning</span>\n                        <span class=\"skill-tag px-4 py-2 rounded-lg text-sm font-bold\" data-kid=\"147\">Git</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"works\" class=\"relative bg-[#010B13] border-t border-white/5\" data-kid=\"148\">\n        <div id=\"works-container\" class=\"flex flex-col md:flex-row relative\" data-kid=\"149\">\n            <div class=\"w-full md:w-[50%] h-[50vh] md:h-screen md:sticky md:top-0 overflow-hidden bg-black z-20\" data-kid=\"150\">\n                <div id=\"video-container\" class=\"relative w-full h-full\" data-kid=\"151\">\n                    <video id=\"showcase-video\" src=\"https://videos.pexels.com/video-files/35146064/14888529_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/35146064/pexels-photo-35146064.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"gsap-target w-full h-full object-cover opacity-60\" data-kid=\"152\"></video>\n                    <div id=\"video-wipe-mask\" class=\"gsap-target video-mask-el absolute inset-0 bg-[#010B13] translate-x-full z-10\" data-kid=\"153\"></div>\n                </div>\n            </div>\n\n            <div class=\"w-full md:w-[50%] bg-[#010B13] relative z-10\" data-kid=\"154\">\n                \n                <div class=\"work-panel min-h-screen flex flex-col justify-center px-8 md:px-20 py-20 border-b border-white/5\" data-kid=\"155\">\n                    <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-6 block uppercase\" data-kid=\"156\">Work / 01</span>\n                    <h3 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter mb-8\" data-kid=\"157\">PTKCS Portal</h3>\n                    <p class=\"text-lg text-white/60 leading-relaxed mb-12 max-w-md\" data-kid=\"158\">Official enterprise portal development focusing on high-performance optimization and scalable full-stack React architecture.</p>\n                    <div class=\"flex flex-wrap gap-3 mb-12\" data-kid=\"159\">\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"160\">React</span>\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"161\">Node.js</span>\n                    </div>\n                    <a href=\"https://www.ptkcs.com/\" target=\"_blank\" class=\"inline-flex items-center gap-4 group\" data-kid=\"162\">\n                        <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-[#8F00FF] group-hover:border-[#8F00FF] transition-all\" data-kid=\"163\">\n                            <i class=\"ti ti-arrow-up-right text-xl\" data-kid=\"164\"></i>\n                        </div>\n                        <span class=\"text-sm font-bold uppercase tracking-widest group-hover:text-[#8F00FF] transition-colors\" data-kid=\"165\">Visit Project</span>\n                    </a>\n                </div>\n\n                \n                <div class=\"work-panel min-h-screen flex flex-col justify-center px-8 md:px-20 py-20 border-b border-white/5\" data-kid=\"166\">\n                    <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-6 block uppercase\" data-kid=\"167\">Work / 02</span>\n                    <h3 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter mb-8\" data-kid=\"168\">Odoo CRM</h3>\n                    <p class=\"text-lg text-white/60 leading-relaxed mb-12 max-w-md\" data-kid=\"169\">Customized CRM and Project modules in Odoo with enhanced dashboards and workflow automation for corporate clients.</p>\n                    <div class=\"flex flex-wrap gap-3 mb-12\" data-kid=\"170\">\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"171\">Python</span>\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"172\">PostgreSQL</span>\n                    </div>\n                    <div class=\"text-sm font-bold uppercase tracking-widest text-white/40\" data-kid=\"173\">Enterprise Solution</div>\n                </div>\n\n                \n                <div class=\"work-panel min-h-screen flex flex-col justify-center px-8 md:px-20 py-20 border-b border-white/5\" data-kid=\"174\">\n                    <span class=\"text-[#8F00FF] font-mono text-xs tracking-[0.4em] mb-6 block uppercase\" data-kid=\"175\">Work / 03</span>\n                    <h3 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter mb-8\" data-kid=\"176\">Travel Website</h3>\n                    <p class=\"text-lg text-white/60 leading-relaxed mb-12 max-w-md\" data-kid=\"177\">Full-stack travel booking platform enabling interactive destination discovery and secure real-time booking management.</p>\n                    <div class=\"flex flex-wrap gap-3 mb-12\" data-kid=\"178\">\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"179\">Spring Boot</span>\n                        <span class=\"px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold uppercase tracking-widest\" data-kid=\"180\">MySQL</span>\n                    </div>\n                    <a href=\"https://travelwebsitefrontend.onrender.com/\" target=\"_blank\" class=\"inline-flex items-center gap-4 group\" data-kid=\"181\">\n                        <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-[#8F00FF] group-hover:border-[#8F00FF] transition-all\" data-kid=\"182\">\n                            <i class=\"ti ti-arrow-up-right text-xl\" data-kid=\"183\"></i>\n                        </div>\n                        <span class=\"text-sm font-bold uppercase tracking-widest group-hover:text-[#8F00FF] transition-colors\" data-kid=\"184\">Visit Platform</span>\n                    </a>\n                </div>\n\n                \n                <div class=\"work-panel min-h-screen flex flex-col justify-center px-8 md:px-20 py-20 bg-black/20\" data-kid=\"185\">\n                    <h4 class=\"font-heading font-bold text-3xl mb-12 uppercase tracking-tighter\" data-kid=\"186\">More Experiments</h4>\n                    <div class=\"space-y-8\" data-kid=\"187\">\n                        <div class=\"flex justify-between items-center border-b border-white/10 pb-6 group\" data-kid=\"188\">\n                            <div data-kid=\"189\">\n                                <h5 class=\"text-xl font-bold mb-1 group-hover:text-[#8F00FF] transition-colors\" data-kid=\"190\">Covid Dashboard</h5>\n                                <span class=\"text-xs text-white/40 uppercase tracking-widest\" data-kid=\"191\">React / Recharts</span>\n                            </div>\n                            <a href=\"https://covid19tracker.ccbp.tech/\" target=\"_blank\" class=\"text-white/40 hover:text-white\" data-kid=\"192\"><i class=\"ti ti-external-link text-2xl\" data-kid=\"193\"></i></a>\n                        </div>\n                        <div class=\"flex justify-between items-center border-b border-white/10 pb-6 group\" data-kid=\"194\">\n                            <div data-kid=\"195\">\n                                <h5 class=\"text-xl font-bold mb-1 group-hover:text-[#8F00FF] transition-colors\" data-kid=\"196\">Emotion AI</h5>\n                                <span class=\"text-xs text-white/40 uppercase tracking-widest\" data-kid=\"197\">Deep Learning / CNN</span>\n                            </div>\n                            <span class=\"text-[10px] uppercase font-bold text-white/20\" data-kid=\"198\">Academic Lead</span>\n                        </div>\n                        <div class=\"flex justify-between items-center border-b border-white/10 pb-6 group\" data-kid=\"199\">\n                            <div data-kid=\"200\">\n                                <h5 class=\"text-xl font-bold mb-1 group-hover:text-[#8F00FF] transition-colors\" data-kid=\"201\">Cricket App</h5>\n                                <span class=\"text-xs text-white/40 uppercase tracking-widest\" data-kid=\"202\">Spring Boot / JPA</span>\n                            </div>\n                            <span class=\"text-[10px] uppercase font-bold text-white/20\" data-kid=\"203\">REST API</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer id=\"footer\" class=\"relative bg-[#010B13] pt-32 pb-16 overflow-hidden border-t border-white/5\" data-kid=\"204\">\n        <div id=\"footer-marquee\" class=\"border-y border-white/5 py-12 mb-32 relative\" data-kid=\"205\">\n            <div id=\"marquee-track\" class=\"gsap-target flex whitespace-nowrap\" data-kid=\"206\">\n                <span class=\"font-heading font-black text-[100px] md:text-[180px] uppercase text-white/5 px-8 leading-none select-none\" data-kid=\"207\">CHANDRASHEKAR — CHANDRASHEKAR — CHANDRASHEKAR — </span>\n                <span class=\"font-heading font-black text-[100px] md:text-[180px] uppercase text-white/5 px-8 leading-none select-none\" data-kid=\"208\">CHANDRASHEKAR — CHANDRASHEKAR — CHANDRASHEKAR — </span>\n            </div>\n        </div>\n\n        <div class=\"max-w-7xl mx-auto px-8 grid grid-cols-1 lg:grid-cols-2 gap-24 items-start\" data-kid=\"209\">\n            <div data-kid=\"210\">\n                <h2 class=\"font-heading font-bold text-5xl md:text-7xl tracking-tighter mb-12\" data-kid=\"211\">Let's talk <span class=\"opacity-40 italic\" data-kid=\"212\">digitally.</span></h2>\n                <div class=\"space-y-12\" data-kid=\"213\">\n                    <a href=\"mailto:hanumanthuchandrashekar972@gmail.com\" class=\"text-xl md:text-3xl font-heading font-bold hover:text-[#8F00FF] transition-colors duration-300 break-all block\" data-kid=\"214\">hanumanthuchandrashekar972@gmail.com</a>\n                    <div class=\"flex gap-16\" data-kid=\"215\">\n                        <div data-kid=\"216\">\n                            <div class=\"text-[10px] uppercase tracking-widest text-white/40 mb-4\" data-kid=\"217\">Phone</div>\n                            <div class=\"font-bold\" data-kid=\"218\">+91 8500394181</div>\n                        </div>\n                        <div data-kid=\"219\">\n                            <div class=\"text-[10px] uppercase tracking-widest text-white/40 mb-4\" data-kid=\"220\">Socials</div>\n                            <div class=\"flex gap-6\" data-kid=\"221\">\n                                <a href=\"https://github.com/ChandrashekarHanumanthu\" target=\"_blank\" class=\"hover:text-[#8F00FF] transition-colors\" data-kid=\"222\">GitHub</a>\n                                <a href=\"https://linkedin.com/in/chandrashekar-hanumanthu-1329232b3\" target=\"_blank\" class=\"hover:text-[#8F00FF] transition-colors\" data-kid=\"223\">LinkedIn</a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"lg:text-right flex flex-col items-start lg:items-end gap-12\" data-kid=\"224\">\n                <div id=\"infinity-box\" class=\"gsap-target w-32 md:w-48 aspect-square flex items-center justify-center border border-white/5 rounded-3xl\" data-kid=\"225\">\n                    <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/various-artists/infinity.svg\" alt=\"Infinity\" class=\"w-2/3 h-2/3 filter invert opacity-20\" decoding=\"async\" loading=\"lazy\" data-kid=\"226\">\n                </div>\n                <div class=\"max-w-xs lg:text-right text-white/40 text-sm leading-relaxed\" data-kid=\"227\">\n                    Designed for high-impact performance. Built with React, GSAP, and a relentless drive for excellence.\n                </div>\n            </div>\n        </div>\n\n        <div class=\"mt-32 text-center border-t border-white/5 pt-12\" data-kid=\"228\">\n            <p class=\"text-[10px] uppercase tracking-[0.6em] text-white/20\" data-kid=\"229\">Designed & Developed by Chandrashekar Hanumanthu / &copy; 2025</p>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"230\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"231\"></script>\n<script type=\"module\" data-kid=\"232\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // 1. Smooth Scroll\n    const lenis = new Lenis({\n        duration: 1.5,\n        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n        smoothWheel: true,\n    });\n\n    gsap.registerPlugin(ScrollTrigger);\n    lenis.on('scroll', ScrollTrigger.update);\n    gsap.ticker.add((time) => {\n        lenis.raf(time * 1000);\n    });\n    gsap.ticker.lagSmoothing(0);\n\n    // 2. Progress Bar\n    lenis.on('scroll', ({ progress }) => {\n        document.getElementById('progress-bar').style.width = (progress * 100) + '%';\n    });\n\n    // 3. Hero Animations\n    const heroTl = gsap.timeline({\n        scrollTrigger: {\n            trigger: \"#hero\",\n            start: \"top top\",\n            end: \"+=100%\",\n            pin: true,\n            scrub: true,\n        }\n    });\n\n    heroTl.to(\"#hero-title\", { scale: 50, opacity: 1, ease: \"none\" }, 0);\n    heroTl.to(\"#hero-orb\", { rotation: 720, scale: 0.2, opacity: 0, ease: \"none\" }, 0);\n\n    // 4. Narrative Sequence\n    const narrativeTl = gsap.timeline({\n        scrollTrigger: {\n            trigger: \"#narrative\",\n            start: \"top top\",\n            end: \"+=2000\",\n            pin: true,\n            scrub: 1,\n        }\n    });\n\n    narrativeTl.to(\"#narrative-filler\", { height: \"100%\", ease: \"none\" }, 0);\n    narrativeTl.to(\".phrase-1\", { y: -60, opacity: 0, ease: \"none\" }, 0.2);\n    narrativeTl.fromTo(\".phrase-2\", { y: 60, opacity: 0 }, { y: 0, opacity: 1, ease: \"none\" }, 0.2);\n    narrativeTl.to(\".phrase-2\", { y: -60, opacity: 0, ease: \"none\" }, 0.6);\n    narrativeTl.fromTo(\".phrase-3\", { y: 60, opacity: 0 }, { y: 0, opacity: 1, ease: \"none\" }, 0.6);\n\n    // 5. Entrance Reveals\n    const reveals = [\n        { selector: \".gsap-reveal-about\", x: -100 },\n        { selector: \".gsap-reveal-about-img\", x: 100 },\n        { selector: \".gsap-reveal-exp\", y: 100, stagger: 0.2 },\n        { selector: \".gsap-reveal-skill\", y: 50, stagger: 0.1 }\n    ];\n\n    reveals.forEach(r => {\n        gsap.from(r.selector, {\n            x: r.x || 0,\n            y: r.y || 0,\n            opacity: 0,\n            duration: 1,\n            stagger: r.stagger || 0,\n            scrollTrigger: {\n                trigger: r.selector,\n                start: \"top 85%\",\n                toggleActions: \"play none none reverse\"\n            }\n        });\n    });\n\n    // 6. Project Video Sync\n    const videoSources = [\n        \"https://videos.pexels.com/video-files/35146064/14888529_640_360_30fps.mp4\",\n        \"https://videos.pexels.com/video-files/33844964/14362795_640_360_30fps.mp4\",\n        \"https://videos.pexels.com/video-files/33840214/14361196_640_360_30fps.mp4\",\n        \"https://videos.pexels.com/video-files/34739799/14726768_640_360_30fps.mp4\"\n    ];\n    \n    const videoEl = document.querySelector(\"#showcase-video\");\n    const panels = document.querySelectorAll(\".work-panel\");\n\n    panels.forEach((panel, i) => {\n        ScrollTrigger.create({\n            trigger: panel,\n            start: \"top center\",\n            end: \"bottom center\",\n            onEnter: () => {\n                gsap.timeline()\n                    .to(\"#video-wipe-mask\", { x: \"0%\", duration: 0.4, ease: \"power2.in\" })\n                    .call(() => { videoEl.src = videoSources[i % videoSources.length]; })\n                    .to(\"#video-wipe-mask\", { x: \"-100%\", duration: 0.4, ease: \"power2.out\" })\n                    .set(\"#video-wipe-mask\", { x: \"100%\" });\n            },\n            onEnterBack: () => {\n                gsap.timeline()\n                    .to(\"#video-wipe-mask\", { x: \"0%\", duration: 0.4, ease: \"power2.in\" })\n                    .call(() => { videoEl.src = videoSources[i % videoSources.length]; })\n                    .to(\"#video-wipe-mask\", { x: \"100%\", duration: 0.4, ease: \"power2.out\" });\n            }\n        });\n    });\n\n    // 7. Footer Loops\n    gsap.to(\"#marquee-track\", { xPercent: -50, duration: 30, repeat: -1, ease: \"none\" });\n    gsap.to(\"#infinity-box\", { rotation: 360, duration: 15, repeat: -1, ease: \"none\" });\n\n    // Idle float for orb\n    gsap.to(\"#orb-outer\", {\n        y: -20,\n        duration: 5,\n        repeat: -1,\n        yoyo: true,\n        ease: \"power1.inOut\"\n    });\n\n    window.addEventListener('resize', () => ScrollTrigger.refresh());\n</script>",
