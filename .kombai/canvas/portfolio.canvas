      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&family=Fira+Code:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #000000;\n    color: #ffffff;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'Fira Code', monospace; }\n\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .text-gradient {\n    background: linear-gradient(to right, #a855f7, #ec4899);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .glow-purple {\n    filter: drop-shadow(0 0 30px rgba(168, 85, 247, 0.4));\n  }\n\n  .timeline-line {\n    width: 2px;\n    background: linear-gradient(to bottom, transparent, #a855f7, #ec4899, transparent);\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-20px); }\n  }\n\n  .animate-float { animation: float 6s ease-in-out infinite; }\n  .animate-float-slow { animation: float 8s ease-in-out infinite; }\n</style>\n\n\n<section class=\"relative min-h-screen flex items-center justify-center px-12 overflow-hidden bg-black\" data-kid=\"1\">\n  \n  <div class=\"absolute top-1/4 -left-20 w-96 h-96 bg-purple-600/20 rounded-full blur-[120px]\" data-kid=\"2\"></div>\n  <div class=\"absolute bottom-1/4 -right-20 w-96 h-96 bg-pink-600/10 rounded-full blur-[120px]\" data-kid=\"3\"></div>\n  \n  \n  <div class=\"absolute inset-0 opacity-10 pointer-events-none\" style=\"background-image: url('https://images.unsplash.com/photo-1768280511074-3b3effe7a139?auto=format&w=1200&q=80&fit=crop'); background-size: cover;\" data-kid=\"4\"></div>\n\n  \n  <div class=\"container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 relative z-10\" data-kid=\"5\">\n    <div class=\"flex flex-col justify-center\" data-kid=\"6\">\n      <div class=\"flex items-center gap-2 mb-6\" data-kid=\"7\">\n        <span class=\"w-12 h-[1px] bg-purple-500\" data-kid=\"8\"></span>\n        <span class=\"font-mono text-sm uppercase tracking-widest text-purple-400\" data-kid=\"9\">Available for projects</span>\n      </div>\n      <h1 class=\"text-7xl lg:text-9xl font-black leading-tight tracking-tighter mb-8\" data-kid=\"10\">\n        CREATIVE<br data-kid=\"11\">\n        <span class=\"text-gradient\" data-kid=\"12\">DEVELOPER</span>\n      </h1>\n      <p class=\"text-slate-400 text-lg max-w-md leading-relaxed mb-10\" data-kid=\"13\">\n        Hi, I'm Chandrashekar. I build high-performance, visually immersive web experiences with modern full-stack technologies.\n      </p>\n      <div class=\"flex items-center gap-6\" data-kid=\"14\">\n        <button class=\"px-8 py-4 bg-white text-black font-bold rounded-sm hover:bg-purple-500 hover:text-white transition-all duration-300 transform hover:scale-105 active:scale-95\" data-kid=\"15\">\n          VIEW PROJECTS\n        </button>\n        <button class=\"group flex items-center gap-3 font-mono text-sm tracking-widest hover:text-purple-400 transition-colors\" data-kid=\"16\">\n          LET'S TALK <i class=\"ti ti-arrow-right group-hover:translate-x-1 transition-transform\" data-kid=\"17\"></i>\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"relative flex items-center justify-center\" data-kid=\"18\">\n      \n      <div class=\"absolute w-64 h-64 bg-purple-500/30 rounded-full blur-[80px] animate-pulse\" data-kid=\"19\"></div>\n      \n      \n      <div class=\"glass w-80 h-[450px] rounded-2xl relative z-20 overflow-hidden flex flex-col p-8 group transition-transform duration-500 hover:rotate-2\" data-kid=\"20\">\n        <div class=\"w-full h-full bg-slate-900/50 rounded-xl overflow-hidden mb-6 border border-white/5\" data-kid=\"21\">\n           \n           <div class=\"w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-800 to-black\" data-kid=\"22\">\n             <i class=\"ti ti-user text-6xl text-white/20\" data-kid=\"23\"></i>\n           </div>\n        </div>\n        <div class=\"space-y-2\" data-kid=\"24\">\n          <div class=\"h-2 w-3/4 bg-white/10 rounded-full\" data-kid=\"25\"></div>\n          <div class=\"h-2 w-1/2 bg-white/5 rounded-full\" data-kid=\"26\"></div>\n        </div>\n        \n        <div class=\"absolute -right-12 top-1/2 -rotate-90 font-mono text-[10px] uppercase tracking-[0.3em] text-white/30 whitespace-nowrap\" data-kid=\"27\">\n          CHANDRASHEKAR_PORTFOLIO_V1.0\n        </div>\n      </div>\n\n      \n      <img src=\"https://images.unsplash.com/photo-1775637463130-b5cff6bab838?auto=format&w=400&q=80&fit=crop\" class=\"absolute -top-10 -right-10 w-32 h-32 object-contain animate-float glow-purple z-30\" alt=\"3D Iridescent Sphere\" loading=\"lazy\" decoding=\"async\" data-kid=\"28\">\n      \n      \n      <img src=\"https://images.unsplash.com/photo-1775637463130-b5cff6bab838?auto=format&w=200&q=80&fit=crop\" class=\"absolute -bottom-12 -left-12 w-24 h-24 object-contain animate-float-slow opacity-60 z-10\" alt=\"3D Iridescent Sphere Smaller\" style=\"filter: hue-rotate(90deg);\" loading=\"lazy\" decoding=\"async\" data-kid=\"29\">\n    </div>\n  </div>\n\n  \n  <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 opacity-40\" data-kid=\"30\">\n    <span class=\"font-mono text-[10px] uppercase tracking-widest\" data-kid=\"31\">Scroll</span>\n    <i class=\"ti ti-arrow-down animate-bounce text-xl\" data-kid=\"32\"></i>\n  </div>\n</section>\n\n\n<section id=\"about\" class=\"bg-slate-950 py-32 px-12 border-t border-white/5\" data-kid=\"33\">\n  <div class=\"container mx-auto\" data-kid=\"34\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-20\" data-kid=\"35\">\n      \n      <div class=\"lg:col-span-4\" data-kid=\"36\">\n        <div class=\"sticky top-32\" data-kid=\"37\">\n          <span class=\"font-mono text-purple-400 text-sm mb-4 block\" data-kid=\"38\">01 / DISCOVERY</span>\n          <h2 class=\"text-6xl font-black tracking-tighter mb-8 uppercase\" data-kid=\"39\">ABOUT<br data-kid=\"40\">ME</h2>\n          <p class=\"text-slate-400 leading-relaxed text-lg mb-8\" data-kid=\"41\">\n            I am a Full Stack Web Developer based in Hyderabad, currently building scalable solutions at Kapil Technologies. My journey is defined by a passion for technical excellence and creative problem-solving.\n          </p>\n          <div class=\"flex flex-wrap gap-4\" data-kid=\"42\">\n             <div class=\"glass px-4 py-2 rounded-full font-mono text-xs border-white/5\" data-kid=\"43\">HITS: 1,240</div>\n             <div class=\"glass px-4 py-2 rounded-full font-mono text-xs border-white/5\" data-kid=\"44\">LVL: SENIOR</div>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-8 relative\" data-kid=\"45\">\n        <div class=\"absolute left-0 top-0 bottom-0 timeline-line\" data-kid=\"46\"></div>\n        \n        <div class=\"space-y-16 pl-12\" data-kid=\"47\">\n          \n          <div class=\"relative group\" data-kid=\"48\">\n            <div class=\"absolute -left-[54px] top-2 w-4 h-4 rounded-full bg-purple-500 shadow-[0_0_15px_rgba(168,85,247,0.8)] z-10\" data-kid=\"49\"></div>\n            <div class=\"glass p-8 rounded-xl transition-all duration-300 group-hover:bg-white/5 group-hover:border-purple-500/30\" data-kid=\"50\">\n              <span class=\"font-mono text-xs text-purple-400 mb-2 block\" data-kid=\"51\">JUL 2025 — PRESENT</span>\n              <h3 class=\"text-2xl font-bold mb-1\" data-kid=\"52\">Web Developer</h3>\n              <p class=\"text-slate-400 font-mono text-sm mb-4\" data-kid=\"53\">Kapil Technologies</p>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"54\">\n                Leading the development of enterprise-level React applications, focusing on scalable architecture and seamless user journeys.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative group\" data-kid=\"55\">\n            <div class=\"absolute -left-[54px] top-2 w-4 h-4 rounded-full bg-slate-700 z-10 transition-colors group-hover:bg-pink-500 group-hover:shadow-[0_0_15px_rgba(236,72,153,0.8)]\" data-kid=\"56\"></div>\n            <div class=\"glass p-8 rounded-xl transition-all duration-300 group-hover:bg-white/5 group-hover:border-pink-500/30\" data-kid=\"57\">\n              <span class=\"font-mono text-xs text-slate-500 mb-2 block group-hover:text-pink-400 transition-colors\" data-kid=\"58\">MAY 2025 — JUN 2025</span>\n              <h3 class=\"text-2xl font-bold mb-1\" data-kid=\"59\">Technical Intern</h3>\n              <p class=\"text-slate-400 font-mono text-sm mb-4\" data-kid=\"60\">Kapil Technologies</p>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"61\">\n                Specialized in Odoo customization, Python backend logic, and PostgreSQL database optimization for client-specific modules.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"relative group\" data-kid=\"62\">\n            <div class=\"absolute -left-[54px] top-2 w-4 h-4 rounded-full bg-slate-700 z-10\" data-kid=\"63\"></div>\n            <div class=\"glass p-8 rounded-xl opacity-60 hover:opacity-100 transition-opacity duration-300\" data-kid=\"64\">\n              <span class=\"font-mono text-xs text-slate-500 mb-2 block\" data-kid=\"65\">2020 — 2024</span>\n              <h3 class=\"text-2xl font-bold mb-1\" data-kid=\"66\">B.Tech in CSE</h3>\n              <p class=\"text-slate-400 font-mono text-sm mb-4\" data-kid=\"67\">Vikas College Of Engineering</p>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"68\">\n                Academic foundation in data structures, algorithms, and deep learning. Led the \"Facial Emotion Recognition\" AI project.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"py-32 px-12 relative overflow-hidden bg-black\" data-kid=\"69\">\n  <div class=\"absolute inset-0 bg-radial-gradient from-purple-900/10 via-transparent to-transparent\" data-kid=\"70\"></div>\n  \n  <div class=\"container mx-auto relative z-10 text-center mb-20\" data-kid=\"71\">\n    <h2 class=\"text-5xl font-black tracking-tighter mb-4 uppercase\" data-kid=\"72\">TECH STACK</h2>\n    <p class=\"text-slate-500 font-mono text-sm tracking-[0.2em]\" data-kid=\"73\">TOOLS_OF_THE_TRADE</p>\n  </div>\n\n  <div class=\"container mx-auto\" data-kid=\"74\">\n    \n    <div class=\"flex flex-wrap justify-center gap-6 max-w-4xl mx-auto\" data-kid=\"75\">\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-purple-500/40 animate-float\" style=\"animation-delay: 0.2s;\" data-kid=\"76\">JAVA</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-pink-500/40 animate-float-slow\" style=\"animation-delay: 0.5s;\" data-kid=\"77\">SPRING_BOOT</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-blue-500/40 animate-float\" style=\"animation-delay: 0.8s;\" data-kid=\"78\">REACT.JS</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-yellow-500/40 animate-float-slow\" style=\"animation-delay: 1.1s;\" data-kid=\"79\">JAVASCRIPT</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-purple-500/40 animate-float\" style=\"animation-delay: 1.4s;\" data-kid=\"80\">NODE.JS</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-green-500/40 animate-float-slow\" style=\"animation-delay: 0.1s;\" data-kid=\"81\">MYSQL</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-red-500/40 animate-float\" style=\"animation-delay: 1.7s;\" data-kid=\"82\">PYTHON</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-cyan-500/40 animate-float-slow\" style=\"animation-delay: 2s;\" data-kid=\"83\">TAILWIND_CSS</div>\n      <div class=\"glass px-8 py-4 rounded-full font-mono text-sm border-white/20 animate-float\" style=\"animation-delay: 0.6s;\" data-kid=\"84\">GIT</div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"projects\" class=\"bg-slate-950 py-32 px-12\" data-kid=\"85\">\n  <div class=\"container mx-auto\" data-kid=\"86\">\n    <div class=\"mb-20 flex justify-between items-end\" data-kid=\"87\">\n      <div data-kid=\"88\">\n        <span class=\"font-mono text-purple-400 text-sm mb-4 block\" data-kid=\"89\">02 / ARTIFACTS</span>\n        <h2 class=\"text-6xl font-black tracking-tighter uppercase leading-none\" data-kid=\"90\">PROJECTS</h2>\n      </div>\n      <a href=\"#\" class=\"font-mono text-xs tracking-widest text-slate-500 hover:text-white transition-colors pb-2 border-b border-slate-800\" data-kid=\"91\">VIEW_ALL_REPOS</a>\n    </div>\n\n    <div class=\"space-y-32\" data-kid=\"92\">\n      \n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center group\" data-kid=\"93\">\n        <div class=\"lg:col-span-7 relative overflow-hidden rounded-2xl border border-white/5 bg-slate-900 aspect-video\" data-kid=\"94\">\n           <img src=\"https://images.unsplash.com/photo-1720962158883-b0f2021fb51e?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 transform group-hover:scale-105\" alt=\"Project Mockup\" loading=\"lazy\" decoding=\"async\" data-kid=\"95\">\n           <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\" data-kid=\"96\"></div>\n        </div>\n        <div class=\"lg:col-span-5 lg:pl-12\" data-kid=\"97\">\n           <div class=\"font-mono text-purple-500 text-sm mb-4 tracking-tighter\" data-kid=\"98\">< REACT / TAILWIND / MONGO ></div>\n           <h3 class=\"text-4xl font-bold mb-6 group-hover:text-purple-400 transition-colors\" data-kid=\"99\">PTKCS Company Portal</h3>\n           <p class=\"text-slate-400 leading-relaxed mb-8\" data-kid=\"100\">\n             A professional-grade company portal featuring a custom dashboard system, secure user authentication, and real-time project tracking metrics.\n           </p>\n           <button class=\"flex items-center gap-3 font-mono text-xs tracking-widest border border-white/10 px-6 py-3 rounded-sm hover:bg-white hover:text-black transition-all\" data-kid=\"101\">\n             SOURCE_CODE <i class=\"ti ti-brand-github text-lg\" data-kid=\"102\"></i>\n           </button>\n        </div>\n      </div>\n\n      \n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center group\" data-kid=\"103\">\n        <div class=\"lg:col-span-5 lg:pr-12 lg:order-1 order-2\" data-kid=\"104\">\n           <div class=\"font-mono text-pink-500 text-sm mb-4 tracking-tighter\" data-kid=\"105\">< PYTHON / ODOO / POSTGRES ></div>\n           <h3 class=\"text-4xl font-bold mb-6 group-hover:text-pink-400 transition-colors\" data-kid=\"106\">CRM Customization</h3>\n           <p class=\"text-slate-400 leading-relaxed mb-8\" data-kid=\"107\">\n             Advanced customization of Odoo CRM and Project modules, including automated workflow triggers and high-fidelity dashboard reporting for enterprise resource planning.\n           </p>\n           <button class=\"flex items-center gap-3 font-mono text-xs tracking-widest border border-white/10 px-6 py-3 rounded-sm hover:bg-white hover:text-black transition-all\" data-kid=\"108\">\n             CASE_STUDY <i class=\"ti ti-external-link text-lg\" data-kid=\"109\"></i>\n           </button>\n        </div>\n        <div class=\"lg:col-span-7 relative overflow-hidden rounded-2xl border border-white/5 bg-slate-900 aspect-video lg:order-2 order-1\" data-kid=\"110\">\n           <img src=\"https://images.unsplash.com/photo-1702479743967-3dcccd4a671d?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 transform group-hover:scale-105\" alt=\"CRM Mockup\" loading=\"lazy\" decoding=\"async\" data-kid=\"111\">\n           <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent\" data-kid=\"112\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"contact\" class=\"bg-black py-32 px-12 relative overflow-hidden\" data-kid=\"113\">\n  \n  <div class=\"absolute -bottom-64 left-1/2 -translate-x-1/2 w-[1200px] h-96 bg-gradient-to-t from-purple-600/20 to-transparent blur-[150px]\" data-kid=\"114\"></div>\n\n  <div class=\"container mx-auto max-w-4xl relative z-10\" data-kid=\"115\">\n    <div class=\"text-center mb-16\" data-kid=\"116\">\n      <span class=\"font-mono text-slate-500 text-sm mb-4 block uppercase tracking-[0.3em]\" data-kid=\"117\">03 / INITIALIZE_LINK</span>\n      <h2 class=\"text-6xl font-black tracking-tighter uppercase\" data-kid=\"118\">GET IN TOUCH</h2>\n    </div>\n\n    \n    <div class=\"bg-slate-900/80 backdrop-blur-xl rounded-xl border border-white/10 shadow-2xl overflow-hidden\" data-kid=\"119\">\n      \n      <div class=\"bg-slate-800/50 px-6 py-4 flex items-center justify-between border-b border-white/5\" data-kid=\"120\">\n        <div class=\"flex gap-2\" data-kid=\"121\">\n          <div class=\"w-3 h-3 rounded-full bg-red-500/60\" data-kid=\"122\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-yellow-500/60\" data-kid=\"123\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-green-500/60\" data-kid=\"124\"></div>\n        </div>\n        <div class=\"font-mono text-[10px] text-slate-500 uppercase tracking-widest\" data-kid=\"125\">zsh — contact_form.sh — 80x24</div>\n        <div class=\"w-12\" data-kid=\"126\"></div>\n      </div>\n      \n      \n      <div class=\"p-10 space-y-8 font-mono\" data-kid=\"127\">\n        <div class=\"flex flex-col gap-2\" data-kid=\"128\">\n          <label class=\"text-purple-400 text-sm\" data-kid=\"129\">> user.name</label>\n          <input type=\"text\" class=\"bg-transparent border-b border-white/10 py-2 focus:border-purple-500 outline-none text-white transition-colors\" placeholder=\"ENTER NAME_\" data-kid=\"130\">\n        </div>\n        <div class=\"flex flex-col gap-2\" data-kid=\"131\">\n          <label class=\"text-purple-400 text-sm\" data-kid=\"132\">> user.email</label>\n          <input type=\"email\" class=\"bg-transparent border-b border-white/10 py-2 focus:border-purple-500 outline-none text-white transition-colors\" placeholder=\"ENTER EMAIL_\" data-kid=\"133\">\n        </div>\n        <div class=\"flex flex-col gap-2\" data-kid=\"134\">\n          <label class=\"text-purple-400 text-sm\" data-kid=\"135\">> message.body</label>\n          <textarea rows=\"4\" class=\"bg-transparent border-b border-white/10 py-2 focus:border-purple-500 outline-none text-white transition-colors resize-none\" placeholder=\"START TYPING_\" data-kid=\"136\"></textarea>\n        </div>\n        <div class=\"pt-6\" data-kid=\"137\">\n          <button class=\"group flex items-center gap-4 text-slate-400 hover:text-white transition-colors\" data-kid=\"138\">\n            <span class=\"px-6 py-3 border border-purple-500/50 rounded-sm text-purple-400 group-hover:bg-purple-500 group-hover:text-white transition-all shadow-[0_0_15px_rgba(168,85,247,0.2)]\" data-kid=\"139\">\n              [ EXECUTE_SEND ]\n            </span>\n            <span class=\"text-[10px] opacity-30 tracking-widest\" data-kid=\"140\">PRESS_ENTER</span>\n          </button>\n        </div>\n      </div>\n    </div>\n    \n    \n    <div class=\"mt-20 flex flex-wrap justify-center gap-12 border-t border-white/5 pt-12\" data-kid=\"141\">\n      <a href=\"#\" class=\"group flex flex-col items-center gap-2\" data-kid=\"142\">\n        <i class=\"ti ti-brand-linkedin text-2xl text-slate-500 group-hover:text-blue-400 transition-all duration-300\" data-kid=\"143\"></i>\n        <span class=\"font-mono text-[10px] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"144\">LINKEDIN</span>\n      </a>\n      <a href=\"#\" class=\"group flex flex-col items-center gap-2\" data-kid=\"145\">\n        <i class=\"ti ti-brand-github text-2xl text-slate-500 group-hover:text-white transition-all duration-300\" data-kid=\"146\"></i>\n        <span class=\"font-mono text-[10px] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"147\">GITHUB</span>\n      </a>\n      <a href=\"#\" class=\"group flex flex-col items-center gap-2\" data-kid=\"148\">\n        <i class=\"ti ti-mail text-2xl text-slate-500 group-hover:text-purple-400 transition-all duration-300\" data-kid=\"149\"></i>\n        <span class=\"font-mono text-[10px] opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"150\">EMAIL</span>\n      </a>\n    </div>\n  </div>\n</section>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"151\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"152\"></script>\n<script data-kid=\"153\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initial Entry Animations\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline();\n    \n    tl.from(\"h1\", {\n      y: 100,\n      opacity: 0,\n      duration: 1.2,\n      ease: \"power4.out\",\n      stagger: 0.2\n    })\n    .from(\"p\", {\n      y: 20,\n      opacity: 0,\n      duration: 0.8\n    }, \"-=0.8\")\n    .from(\".glass\", {\n      scale: 0.9,\n      opacity: 0,\n      duration: 1,\n      ease: \"power2.out\"\n    }, \"-=1\");\n\n    // Scroll Triggered Animations for Sections\n    gsap.utils.toArray('section').forEach(section => {\n      gsap.from(section.querySelectorAll('h2, .glass'), {\n        scrollTrigger: {\n          trigger: section,\n          start: \"top 80%\",\n        },\n        y: 50,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.1,\n        ease: \"power3.out\"\n      });\n    });\n\n    // Sticky Scroll Effect for Project Images\n    gsap.utils.toArray('.group img').forEach(img => {\n      gsap.to(img, {\n        scrollTrigger: {\n          trigger: img,\n          scrub: true,\n          start: \"top bottom\",\n          end: \"bottom top\"\n        },\n        y: -30\n      });\n    });\n  });\n</script>",
