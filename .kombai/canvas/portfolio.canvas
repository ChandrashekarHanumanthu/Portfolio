      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@900&family=Fira+Code:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #000000;\n    color: #FFFFFF;\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .mono { font-family: 'Fira Code', monospace; }\n\n  .grid-line {\n    border-color: #1e293b; /* slate-800 */\n  }\n\n  .marquee-container {\n    overflow: hidden;\n    white-space: nowrap;\n    border-bottom: 1px solid #1e293b;\n  }\n\n  .marquee-content {\n    display: inline-block;\n    animation: marquee 20s linear infinite;\n  }\n\n  @keyframes marquee {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n\n  .receipt-edge {\n    background-image: radial-gradient(circle, transparent 70%, #000 70%);\n    background-size: 20px 20px;\n    background-position: 0 -10px;\n  }\n</style>\n\n<div class=\"min-h-screen selection:bg-pink-500 selection:text-white\" data-kid=\"1\">\n  \n  <div class=\"marquee-container py-4 bg-black\" data-kid=\"2\">\n    <div class=\"marquee-content text-pink-500 mono font-bold text-xl uppercase tracking-widest\" data-kid=\"3\">\n      PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 // PORTFOLIO // 2024 //\n    </div>\n  </div>\n\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-2 grid-rows-2 h-[calc(100vh-64px)] grid-line border-b border-r\" data-kid=\"4\">\n    \n    <div class=\"grid-line border-b md:border-r p-8 flex items-center justify-center overflow-hidden\" data-kid=\"5\">\n      <h1 class=\"text-[15vw] leading-none font-black tracking-tighter m-0\" data-kid=\"6\">HELLO.</h1>\n    </div>\n    \n    \n    <div class=\"grid-line border-b flex items-center justify-center relative overflow-hidden group\" data-kid=\"7\">\n      <img src=\"https://images.pexels.com/photos/10562328/pexels-photo-10562328.jpeg?auto=format&w=800&q=80&fit=crop\" alt=\"Chandrashekar Portrait\" class=\"w-full h-full object-cover grayscale brightness-75 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-in-out\" decoding=\"async\" loading=\"lazy\" data-kid=\"8\">\n    </div>\n\n    \n    <div class=\"grid-line md:border-r p-12 flex flex-col justify-between\" data-kid=\"9\">\n      <div class=\"mono text-slate-400 text-lg max-w-md space-y-4\" data-kid=\"10\">\n        <p class=\"text-white font-bold\" data-kid=\"11\">[ USER_INFO ]</p>\n        <p data-kid=\"12\">CHANDRASHEKAR HANUMANTHU</p>\n        <p data-kid=\"13\">FULL STACK WEB DEVELOPER // SPECIALIZING IN JAVA, SPRING BOOT & REACT.</p>\n        <p data-kid=\"14\">CURRENTLY BUILDING SCALABLE SOLUTIONS @ KAPIL TECHNOLOGIES.</p>\n      </div>\n      <div class=\"mt-8\" data-kid=\"15\">\n        <button class=\"bg-white text-black px-8 py-4 font-black hover:bg-pink-500 hover:text-white transition-colors uppercase\" data-kid=\"16\">\n          Download_Resume\n        </button>\n      </div>\n    </div>\n\n    \n    <div class=\"flex items-center justify-center p-8 group cursor-pointer overflow-hidden\" data-kid=\"17\">\n      <i id=\"hero-arrow\" class=\"ti ti-arrow-down-right text-[15vw] text-slate-800 group-hover:text-pink-500 transition-colors duration-500\" data-kid=\"18\"></i>\n    </div>\n  </div>\n\n  \n  <div class=\"max-w-6xl mx-auto my-32 px-4\" data-kid=\"19\">\n    <div class=\"border-2 border-white relative p-1 pb-0 overflow-hidden\" data-kid=\"20\">\n      \n      <div class=\"absolute top-0 left-0 right-0 h-4 border-b-2 border-dashed border-white -mt-2\" data-kid=\"21\"></div>\n      \n      <div class=\"bg-black p-12 grid grid-cols-1 md:grid-cols-2 gap-16 border-t-2 border-dashed border-white\" data-kid=\"22\">\n        \n        <div class=\"space-y-8\" data-kid=\"23\">\n          <div class=\"flex items-center gap-4\" data-kid=\"24\">\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/floppy-disk.svg\" class=\"w-8 h-8\" alt=\"floppy disk icon\" data-kid=\"25\">\n            <h2 class=\"mono text-2xl font-bold tracking-tight uppercase\" data-kid=\"26\">SKILLS_INVENTORY.TXT</h2>\n          </div>\n          <div class=\"mono space-y-2 text-xl\" data-kid=\"27\">\n            <div class=\"flex justify-between border-b border-slate-800 py-2 group cursor-default\" data-kid=\"28\">\n              <span class=\"text-slate-500\" data-kid=\"29\">01</span>\n              <span class=\"group-hover:text-pink-500 transition-colors uppercase\" data-kid=\"30\">Java_Spring_Boot</span>\n            </div>\n            <div class=\"flex justify-between border-b border-slate-800 py-2 group cursor-default\" data-kid=\"31\">\n              <span class=\"text-slate-500\" data-kid=\"32\">02</span>\n              <span class=\"group-hover:text-pink-500 transition-colors uppercase\" data-kid=\"33\">React.js_Tailwind</span>\n            </div>\n            <div class=\"flex justify-between border-b border-slate-800 py-2 group cursor-default\" data-kid=\"34\">\n              <span class=\"text-slate-500\" data-kid=\"35\">03</span>\n              <span class=\"group-hover:text-pink-500 transition-colors uppercase\" data-kid=\"36\">Node.js_MongoDB</span>\n            </div>\n            <div class=\"flex justify-between border-b border-slate-800 py-2 group cursor-default\" data-kid=\"37\">\n              <span class=\"text-slate-500\" data-kid=\"38\">04</span>\n              <span class=\"group-hover:text-pink-500 transition-colors uppercase\" data-kid=\"39\">PostgreSQL_MySQL</span>\n            </div>\n            <div class=\"flex justify-between border-b border-slate-800 py-2 group cursor-default\" data-kid=\"40\">\n              <span class=\"text-slate-500\" data-kid=\"41\">05</span>\n              <span class=\"group-hover:text-pink-500 transition-colors uppercase\" data-kid=\"42\">Odoo_Python</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"space-y-8\" data-kid=\"43\">\n           <div class=\"flex items-center gap-4\" data-kid=\"44\">\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/wrench.svg\" class=\"w-8 h-8\" alt=\"wrench icon\" data-kid=\"45\">\n            <h2 class=\"mono text-2xl font-bold tracking-tight uppercase\" data-kid=\"46\">ABOUT_ME</h2>\n          </div>\n          <p class=\"text-xl leading-relaxed\" data-kid=\"47\">\n            I'm a passionate developer focused on building <span class=\"bg-indigo-600 px-2 py-1 font-bold\" data-kid=\"48\">highly scalable</span> and <span class=\"bg-pink-600 px-2 py-1 font-bold\" data-kid=\"49\">user-centric</span> applications. With a foundation in Java and modern frontend frameworks, I bridge the gap between complex backend logic and seamless user interfaces.\n          </p>\n          <div class=\"grid grid-cols-2 gap-4 mono text-sm\" data-kid=\"50\">\n            <div class=\"border border-slate-800 p-4\" data-kid=\"51\">\n              <p class=\"text-slate-500\" data-kid=\"52\">LOC:</p>\n              <p data-kid=\"53\">HYDERABAD, IN</p>\n            </div>\n            <div class=\"border border-slate-800 p-4\" data-kid=\"54\">\n              <p class=\"text-slate-500\" data-kid=\"55\">AVAIL:</p>\n              <p data-kid=\"56\">FULL_TIME</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"border-t border-slate-800 mt-32\" data-kid=\"57\">\n    <div class=\"px-8 py-4 mono text-slate-500 border-b border-slate-800\" data-kid=\"58\">SELECTED_PROJECTS</div>\n    \n    \n    <div class=\"project-row border-b border-slate-800 group cursor-pointer overflow-hidden transition-all duration-500\" data-kid=\"59\">\n      <div class=\"flex justify-between items-center p-8 group-hover:bg-slate-900 transition-colors\" data-kid=\"60\">\n        <h3 class=\"text-6xl md:text-8xl font-black tracking-tighter uppercase m-0 group-hover:translate-x-4 transition-transform duration-500\" data-kid=\"61\">PTKCS Portal</h3>\n        <span class=\"mono text-xl text-slate-500 group-hover:text-white transition-colors\" data-kid=\"62\">2024</span>\n      </div>\n      <div class=\"max-h-0 group-hover:max-h-[800px] transition-all duration-700 ease-in-out\" data-kid=\"63\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 p-8 gap-12 bg-slate-950\" data-kid=\"64\">\n          <img src=\"https://images.pexels.com/photos/8168566/pexels-photo-8168566.png?auto=format&w=800&q=80&fit=crop\" class=\"w-full aspect-video object-cover grayscale invert border border-white/20\" alt=\"Project Wireframe\" decoding=\"async\" loading=\"lazy\" data-kid=\"65\">\n          <div class=\"flex flex-col justify-center space-y-6\" data-kid=\"66\">\n            <p class=\"mono text-slate-400 text-lg uppercase\" data-kid=\"67\">\n              Full-featured company portal built for enterprise management. High focus on dashboard data visualization and real-time updates.\n            </p>\n            <div class=\"flex gap-4\" data-kid=\"68\">\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"69\">REACT</span>\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"70\">NODE.JS</span>\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"71\">MONGODB</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"project-row border-b border-slate-800 group cursor-pointer overflow-hidden transition-all duration-500\" data-kid=\"72\">\n      <div class=\"flex justify-between items-center p-8 group-hover:bg-slate-900 transition-colors\" data-kid=\"73\">\n        <h3 class=\"text-6xl md:text-8xl font-black tracking-tighter uppercase m-0 group-hover:translate-x-4 transition-transform duration-500\" data-kid=\"74\">Odoo_CRM</h3>\n        <span class=\"mono text-xl text-slate-500 group-hover:text-white transition-colors\" data-kid=\"75\">2023</span>\n      </div>\n      <div class=\"max-h-0 group-hover:max-h-[800px] transition-all duration-700 ease-in-out\" data-kid=\"76\">\n         <div class=\"grid grid-cols-1 md:grid-cols-2 p-8 gap-12 bg-slate-950\" data-kid=\"77\">\n           <div class=\"flex flex-col justify-center space-y-6\" data-kid=\"78\">\n            <p class=\"mono text-slate-400 text-lg uppercase\" data-kid=\"79\">\n              Custom CRM modules for workflow automation. Enhanced lead tracking and automated reporting systems.\n            </p>\n            <div class=\"flex gap-4\" data-kid=\"80\">\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"81\">ODOO</span>\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"82\">PYTHON</span>\n              <span class=\"border border-pink-500 text-pink-500 px-3 py-1 mono text-sm\" data-kid=\"83\">POSTGRES</span>\n            </div>\n          </div>\n          <img src=\"https://images.pexels.com/photos/12843337/pexels-photo-12843337.jpeg?auto=format&w=800&q=80&fit=crop\" class=\"w-full aspect-video object-cover grayscale invert border border-white/20\" alt=\"Project Wireframe\" decoding=\"async\" loading=\"lazy\" data-kid=\"84\">\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"mt-48 px-8 pb-32\" data-kid=\"85\">\n    <div class=\"max-w-4xl mx-auto space-y-12\" data-kid=\"86\">\n      <div class=\"flex justify-between items-end border-b border-slate-800 pb-8\" data-kid=\"87\">\n        <h2 class=\"text-8xl font-black tracking-tighter uppercase m-0\" data-kid=\"88\">CONTACT.</h2>\n        <span class=\"mono text-slate-500\" data-kid=\"89\">GET_IN_TOUCH.SH</span>\n      </div>\n      \n      <form class=\"space-y-16\" data-kid=\"90\">\n        <div class=\"group border-b border-slate-800\" data-kid=\"91\">\n          <input type=\"text\" placeholder=\"YOUR NAME\" class=\"w-full bg-transparent border-none py-8 text-5xl md:text-8xl font-black uppercase focus:outline-hidden placeholder:text-slate-900 focus:placeholder:text-slate-800 transition-all\" data-kid=\"92\">\n        </div>\n        <div class=\"group border-b border-slate-800\" data-kid=\"93\">\n          <input type=\"email\" placeholder=\"YOUR EMAIL\" class=\"w-full bg-transparent border-none py-8 text-5xl md:text-8xl font-black uppercase focus:outline-hidden placeholder:text-slate-900 focus:placeholder:text-slate-800 transition-all\" data-kid=\"94\">\n        </div>\n        <div class=\"group border-b border-slate-800\" data-kid=\"95\">\n          <textarea placeholder=\"YOUR MESSAGE\" rows=\"1\" class=\"w-full bg-transparent border-none py-8 text-5xl md:text-8xl font-black uppercase focus:outline-hidden placeholder:text-slate-900 focus:placeholder:text-slate-800 transition-all resize-none\" data-kid=\"96\"></textarea>\n        </div>\n        \n        <button class=\"w-full py-12 text-5xl md:text-7xl font-black bg-white text-black hover:bg-pink-500 hover:text-white transition-all duration-500 uppercase tracking-tighter\" data-kid=\"97\">\n          Send_Message\n        </button>\n      </form>\n    </div>\n  </div>\n\n  \n  <footer class=\"border-t border-slate-800 p-12 grid grid-cols-1 md:grid-cols-3 gap-12 mono text-sm text-slate-500 uppercase\" data-kid=\"98\">\n    <div data-kid=\"99\">\n      <p class=\"text-white mb-4\" data-kid=\"100\">SOCIALS</p>\n      <div class=\"space-y-1\" data-kid=\"101\">\n        <a href=\"#\" class=\"block hover:text-white\" data-kid=\"102\">LINKEDIN</a>\n        <a href=\"#\" class=\"block hover:text-white\" data-kid=\"103\">GITHUB</a>\n        <a href=\"#\" class=\"block hover:text-white\" data-kid=\"104\">TWITTER</a>\n      </div>\n    </div>\n    <div data-kid=\"105\">\n      <p class=\"text-white mb-4\" data-kid=\"106\">CONTACT</p>\n      <p data-kid=\"107\">HANUMANTHUCHANDRASHEKAR972@GMAIL.COM</p>\n      <p data-kid=\"108\">+91 8500394181</p>\n    </div>\n    <div class=\"md:text-right flex flex-col justify-end\" data-kid=\"109\">\n      <p data-kid=\"110\">© 2024 CHANDRASHEKAR. ALL RIGHTS RESERVED.</p>\n      <p data-kid=\"111\">BUILT_WITH_REBELLION</p>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"112\"></script>\n<script data-kid=\"113\">\n  // Initial entrance animations\n  window.addEventListener('load', () => {\n    gsap.from(\"h1\", {\n      y: 100,\n      opacity: 0,\n      duration: 1.5,\n      ease: \"expo.out\"\n    });\n\n    gsap.from(\".grid-line\", {\n      scaleX: 0,\n      duration: 1,\n      stagger: 0.2,\n      ease: \"power4.inOut\"\n    });\n\n    // Hero Arrow rotation\n    const arrow = document.getElementById('hero-arrow');\n    gsap.to(arrow, {\n      rotation: 360,\n      duration: 20,\n      repeat: -1,\n      ease: \"none\"\n    });\n\n    // Hover effect for projects\n    document.querySelectorAll('.project-row').forEach(row => {\n      row.addEventListener('mouseenter', () => {\n        gsap.to(row.querySelector('h3'), { x: 20, duration: 0.3 });\n      });\n      row.addEventListener('mouseleave', () => {\n        gsap.to(row.querySelector('h3'), { x: 0, duration: 0.3 });\n      });\n    });\n  });\n\n  // Simple auto-expand for textarea\n  const textarea = document.querySelector('textarea');\n  textarea.addEventListener('input', () => {\n    textarea.style.height = 'auto';\n    textarea.style.height = textarea.scrollHeight + 'px';\n  });\n</script>",
