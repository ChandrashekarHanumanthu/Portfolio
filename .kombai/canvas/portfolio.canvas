    },
    "var_d350d1305cf6": {
      "type": "variant",
      "label": "Neo-Brutalist Portfolio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@900&family=Fira+Code:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-heading { font-family: 'Inter', sans-serif; }\n  .font-mono { font-family: 'Fira Code', monospace; }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .animate-marquee {\n    display: flex;\n    width: 200%;\n    animation: marquee 20s linear infinite;\n  }\n\n  .grid-border { border-color: var(--color-slate-800); }\n  \n  /* Custom Scrollbar for Neo-Brutalist look */\n  ::-webkit-scrollbar { width: 12px; }\n  ::-webkit-scrollbar-track { background: #000; }\n  ::-webkit-scrollbar-thumb { background: #1e293b; border: 3px solid #000; }\n  ::-webkit-scrollbar-thumb:hover { background: #334155; }\n</style>\n\n<div class=\"bg-black text-white font-mono min-h-screen selection:bg-pink-500 selection:text-white\" data-kid=\"1\">\n  \n  \n  <div class=\"border-b border-slate-800 overflow-hidden py-4 bg-black\" data-kid=\"2\">\n    <div class=\"animate-marquee whitespace-nowrap\" data-kid=\"3\">\n      <span class=\"text-pink-500 text-2xl font-bold uppercase tracking-widest px-8\" data-kid=\"4\">PORTFOLIO // 2024 // FULL STACK DEVELOPER // PORTFOLIO // 2024 // CHANDRASHEKAR //</span>\n      <span class=\"text-pink-500 text-2xl font-bold uppercase tracking-widest px-8\" data-kid=\"5\">PORTFOLIO // 2024 // FULL STACK DEVELOPER // PORTFOLIO // 2024 // CHANDRASHEKAR //</span>\n    </div>\n  </div>\n\n  \n  <section class=\"grid grid-cols-2 border-b border-slate-800\" data-kid=\"6\">\n    \n    <div class=\"border-r border-slate-800 p-12 flex items-end justify-start min-h-[500px]\" data-kid=\"7\">\n      <h1 class=\"font-heading text-[15rem] leading-[0.8] tracking-tighter uppercase hero-text opacity-0\" data-kid=\"8\">\n        HELLO.\n      </h1>\n    </div>\n    \n    \n    <div class=\"relative overflow-hidden group\" data-kid=\"9\">\n      <img src=\"https://images.unsplash.com/photo-1620122303020-87ec826cf70d?auto=format&w=800&q=80&fit=crop\" alt=\"Chandrashekar Portrait\" class=\"w-full h-full object-cover grayscale contrast-125 brightness-75 transition-transform duration-700 group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" data-kid=\"10\">\n      <div class=\"absolute inset-0 bg-black/20 mix-blend-overlay\" data-kid=\"11\"></div>\n    </div>\n\n    \n    <div class=\"border-t border-r border-slate-800 p-12 flex flex-col justify-between\" data-kid=\"12\">\n      <p class=\"text-xl max-w-md leading-relaxed bio-text opacity-0\" data-kid=\"13\">\n        I'm Chandrashekar, a <span class=\"text-lavender-400 font-bold\" data-kid=\"14\">Java Full Stack Developer</span> specializing in building enterprise-grade applications. Currently shaping scalable solutions at Kapil Technologies.\n      </p>\n      <div class=\"flex gap-8 mt-12\" data-kid=\"15\">\n        <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"16\">GH.</a>\n        <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"17\">LN.</a>\n        <a href=\"#\" class=\"text-slate-400 hover:text-white transition-colors\" data-kid=\"18\">TW.</a>\n      </div>\n    </div>\n\n    \n    <div class=\"border-t border-slate-800 flex items-center justify-center p-12 group cursor-pointer overflow-hidden relative\" data-kid=\"19\">\n      <div class=\"absolute inset-0 bg-lavender-400 translate-y-full transition-transform duration-500 group-hover:translate-y-0\" data-kid=\"20\"></div>\n      <i class=\"ti ti-arrow-down-right text-[12rem] relative z-10 transition-transform duration-500 group-hover:rotate-45 group-hover:text-black\" data-kid=\"21\"></i>\n    </div>\n  </section>\n\n  \n  <section class=\"p-12 border-b border-slate-800\" data-kid=\"22\">\n    <div class=\"border-2 border-white p-8 relative overflow-hidden\" data-kid=\"23\">\n      \n      <div class=\"absolute top-0 left-0 right-0 h-1 border-t-4 border-dashed border-black -mt-0.5\" data-kid=\"24\"></div>\n      \n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16\" data-kid=\"25\">\n        \n        <div data-kid=\"26\">\n          <h2 class=\"text-sm font-bold text-slate-500 mb-8 tracking-[0.3em]\" data-kid=\"27\">SKILLS_INVENTORY.TXT</h2>\n          <div class=\"space-y-4\" data-kid=\"28\">\n            <div class=\"flex justify-between items-center group cursor-default border-b border-slate-800 pb-2\" data-kid=\"29\">\n              <span class=\"text-slate-500\" data-kid=\"30\">01_</span>\n              <span class=\"text-2xl font-bold group-hover:text-lavender-400 transition-colors\" data-kid=\"31\">JAVA_SPRINGBOOT</span>\n            </div>\n            <div class=\"flex justify-between items-center group cursor-default border-b border-slate-800 pb-2\" data-kid=\"32\">\n              <span class=\"text-slate-500\" data-kid=\"33\">02_</span>\n              <span class=\"text-2xl font-bold group-hover:text-lavender-400 transition-colors\" data-kid=\"34\">REACT_JS</span>\n            </div>\n            <div class=\"flex justify-between items-center group cursor-default border-b border-slate-800 pb-2\" data-kid=\"35\">\n              <span class=\"text-slate-500\" data-kid=\"36\">03_</span>\n              <span class=\"text-2xl font-bold group-hover:text-lavender-400 transition-colors\" data-kid=\"37\">NODE_JS</span>\n            </div>\n            <div class=\"flex justify-between items-center group cursor-default border-b border-slate-800 pb-2\" data-kid=\"38\">\n              <span class=\"text-slate-500\" data-kid=\"39\">04_</span>\n              <span class=\"text-2xl font-bold group-hover:text-lavender-400 transition-colors\" data-kid=\"40\">MYSQL_POSTGRES</span>\n            </div>\n            <div class=\"flex justify-between items-center group cursor-default border-b border-slate-800 pb-2\" data-kid=\"41\">\n              <span class=\"text-slate-500\" data-kid=\"42\">05_</span>\n              <span class=\"text-2xl font-bold group-hover:text-lavender-400 transition-colors\" data-kid=\"43\">ODOO_PYTHON</span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex flex-col justify-between\" data-kid=\"44\">\n          <div data-kid=\"45\">\n            <h2 class=\"text-sm font-bold text-slate-500 mb-8 tracking-[0.3em]\" data-kid=\"46\">CORE_INFO</h2>\n            <div class=\"bg-white text-black p-6 mb-8 transform -rotate-1 shadow-[8px_8px_0px_#818cf8]\" data-kid=\"47\">\n              <p class=\"text-lg font-bold\" data-kid=\"48\">\n                Passionate about building scalable and user-friendly applications. I focus on creating responsive interfaces and robust backend solutions.\n              </p>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-4 text-slate-500\" data-kid=\"49\">\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/mono/floppy-disk.svg\" class=\"w-8 h-8 opacity-50\" style=\"color: currentColor;\" data-kid=\"50\">\n            <span class=\"text-xs\" data-kid=\"51\">SYSTEM STATUS: OPTIMIZED</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"projects-container\" data-kid=\"52\">\n    <div class=\"project-row border-b border-slate-800 group cursor-pointer\" onclick=\"toggleProject(this)\" data-kid=\"53\">\n      <div class=\"flex justify-between items-center p-12 transition-colors group-hover:bg-slate-900\" data-kid=\"54\">\n        <h3 class=\"font-heading text-8xl uppercase tracking-tighter\" data-kid=\"55\">PROJECT_01</h3>\n        <span class=\"text-slate-500 text-2xl font-bold\" data-kid=\"56\">/ 2024</span>\n      </div>\n      <div class=\"project-content overflow-hidden max-h-0 bg-slate-950\" data-kid=\"57\">\n        <div class=\"grid grid-cols-2 gap-12 p-12 border-t border-slate-800\" data-kid=\"58\">\n          <div class=\"space-y-6\" data-kid=\"59\">\n            <h4 class=\"text-3xl font-bold text-lavender-400\" data-kid=\"60\">ODOO CRM CUSTOMIZATION</h4>\n            <p class=\"text-slate-400 leading-relaxed\" data-kid=\"61\">\n              Customized CRM and Project modules in Odoo with enhanced dashboards and workflow automation. Improved operational efficiency by 30%.\n            </p>\n            <div class=\"flex gap-4\" data-kid=\"62\">\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"63\">ODOO</span>\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"64\">PYTHON</span>\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"65\">POSTGRES</span>\n            </div>\n          </div>\n          <div class=\"relative aspect-video overflow-hidden border border-slate-800\" data-kid=\"66\">\n            <img src=\"https://images.unsplash.com/photo-1658953229625-aad99d7603b4?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"67\">\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"project-row border-b border-slate-800 group cursor-pointer\" onclick=\"toggleProject(this)\" data-kid=\"68\">\n      <div class=\"flex justify-between items-center p-12 transition-colors group-hover:bg-slate-900\" data-kid=\"69\">\n        <h3 class=\"font-heading text-8xl uppercase tracking-tighter\" data-kid=\"70\">PROJECT_02</h3>\n        <span class=\"text-slate-500 text-2xl font-bold\" data-kid=\"71\">/ 2024</span>\n      </div>\n      <div class=\"project-content overflow-hidden max-h-0 bg-slate-950\" data-kid=\"72\">\n        <div class=\"grid grid-cols-2 gap-12 p-12 border-t border-slate-800\" data-kid=\"73\">\n          <div class=\"space-y-6\" data-kid=\"74\">\n            <h4 class=\"text-3xl font-bold text-lavender-400\" data-kid=\"75\">KCS TECH COMPANY PORTAL</h4>\n            <p class=\"text-slate-400 leading-relaxed\" data-kid=\"76\">\n              A comprehensive portal for internal management, featuring real-time data visualization and secure role-based access control.\n            </p>\n            <div class=\"flex gap-4\" data-kid=\"77\">\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"78\">REACT</span>\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"79\">NODE</span>\n              <span class=\"border border-white px-3 py-1 text-xs\" data-kid=\"80\">MONGODB</span>\n            </div>\n          </div>\n          <div class=\"relative aspect-video overflow-hidden border border-slate-800\" data-kid=\"81\">\n            <img src=\"https://images.unsplash.com/photo-1702479743967-3dcccd4a671d?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"82\">\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"p-12 py-32\" data-kid=\"83\">\n    <div class=\"max-w-4xl mx-auto space-y-12\" data-kid=\"84\">\n      <div class=\"relative\" data-kid=\"85\">\n        <label class=\"text-xs font-bold text-slate-500 uppercase tracking-widest absolute -top-6 left-0\" data-kid=\"86\">YOUR NAME</label>\n        <input type=\"text\" placeholder=\"CHANDRA...\" class=\"w-full bg-transparent border-b-2 border-slate-800 py-6 text-5xl font-heading uppercase focus:outline-hidden focus:border-lavender-400 transition-colors placeholder:text-slate-900\" data-kid=\"87\">\n      </div>\n      <div class=\"relative\" data-kid=\"88\">\n        <label class=\"text-xs font-bold text-slate-500 uppercase tracking-widest absolute -top-6 left-0\" data-kid=\"89\">EMAIL ADDRESS</label>\n        <input type=\"email\" placeholder=\"HELLO@WORLD.COM\" class=\"w-full bg-transparent border-b-2 border-slate-800 py-6 text-5xl font-heading uppercase focus:outline-hidden focus:border-lavender-400 transition-colors placeholder:text-slate-900\" data-kid=\"90\">\n      </div>\n      <div class=\"relative\" data-kid=\"91\">\n        <label class=\"text-xs font-bold text-slate-500 uppercase tracking-widest absolute -top-6 left-0\" data-kid=\"92\">MESSAGE</label>\n        <textarea placeholder=\"WHAT'S ON YOUR MIND?\" rows=\"1\" class=\"w-full bg-transparent border-b-2 border-slate-800 py-6 text-5xl font-heading uppercase focus:outline-hidden focus:border-lavender-400 transition-colors placeholder:text-slate-900 resize-none\" data-kid=\"93\"></textarea>\n      </div>\n    </div>\n    \n    <button class=\"w-full border-t border-slate-800 py-24 group relative overflow-hidden mt-32\" data-kid=\"94\">\n      <div class=\"absolute inset-0 bg-white translate-y-full transition-transform duration-500 group-hover:translate-y-0\" data-kid=\"95\"></div>\n      <span class=\"relative z-10 font-heading text-8xl uppercase tracking-tighter group-hover:text-black transition-colors\" data-kid=\"96\">SEND_MESSAGE</span>\n    </button>\n  </section>\n\n  \n  <footer class=\"p-12 border-t border-slate-800 flex justify-between items-center text-slate-500 text-xs uppercase tracking-widest\" data-kid=\"97\">\n    <span data-kid=\"98\">DESIGNED FOR IMPACT</span>\n    <span data-kid=\"99\">©2024 CHANDRA.PORTFOLIO</span>\n    <span data-kid=\"100\">HYDERABAD, IN</span>\n  </footer>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"101\"></script>\n<script data-kid=\"102\">\n  // Page entry animations\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline();\n    \n    tl.to('.hero-text', { opacity: 1, y: 0, duration: 1, ease: 'power4.out' })\n      .to('.bio-text', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.5');\n  });\n\n  // Accordion Logic\n  function toggleProject(element) {\n    const content = element.querySelector('.project-content');\n    const allContents = document.querySelectorAll('.project-content');\n    const allRows = document.querySelectorAll('.project-row');\n    \n    // Close others\n    allContents.forEach(c => {\n      if (c !== content) gsap.to(c, { maxHeight: 0, duration: 0.5, ease: 'power2.inOut' });\n    });\n    \n    allRows.forEach(r => {\n      if (r !== element) r.classList.remove('active-row');\n    });\n\n    // Toggle current\n    const isOpen = content.style.maxHeight !== '0px' && content.style.maxHeight !== '';\n    \n    if (isOpen) {\n      gsap.to(content, { maxHeight: 0, duration: 0.5, ease: 'power2.inOut' });\n      element.classList.remove('active-row');\n    } else {\n      gsap.to(content, { maxHeight: '2000px', duration: 0.8, ease: 'power3.out' });\n      element.classList.add('active-row');\n    }\n  }\n\n  // Auto-resize textarea\n  const textarea = document.querySelector('textarea');\n  textarea.addEventListener('input', () => {\n    textarea.style.height = 'auto';\n    textarea.style.height = textarea.scrollHeight + 'px';\n  });\n</script>",
