    "var_c7484ebe0a05": {
      "type": "variant",
      "label": "Swiss Agency Portfolio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
