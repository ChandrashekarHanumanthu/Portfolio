      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100;200;400;700;800;900&family=Fira+Code:wght@300;400;500&display=swap');\n\n  :root {\n    --color-bg: #000000;\n    --color-text-primary: #ffffff;\n    --color-text-muted: rgba(255, 255, 255, 0.5);\n    --color-accent-purple: #9333ea;\n    --color-accent-pink: #db2777;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-text-primary);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-thin { font-weight: 100; }\n  .font-extralight { font-weight: 200; }\n  .font-mono { font-family: 'Fira Code', monospace; }\n\n  /* Hairline Frame */\n  .frame-line {\n    position: fixed;\n    background: rgba(255, 255, 255, 0.1);\n    z-index: 50;\n    pointer-events: none;\n  }\n  .frame-top { top: 40px; left: 40px; right: 40px; height: 1px; }\n  .frame-bottom { bottom: 40px; left: 40px; right: 40px; height: 1px; }\n  .frame-left { top: 40px; bottom: 40px; left: 40px; width: 1px; }\n  .frame-right { top: 40px; bottom: 40px; right: 40px; width: 1px; }\n\n  /* Navigation Corners */\n  .nav-corner {\n    position: fixed;\n    padding: 20px;\n    z-index: 60;\n    font-size: 10px;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n  }\n\n  /* Glass Effects */\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  /* Animations */\n  @keyframes pulse-slow {\n    0%, 100% { opacity: 0.3; transform: scale(1); }\n    50% { opacity: 0.6; transform: scale(1.1); }\n  }\n  .animate-pulse-slow {\n    animation: pulse-slow 8s infinite ease-in-out;\n  }\n\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n\n  /* Constellation Canvas */\n  #constellation {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n  }\n</style>\n\n\n<div class=\"frame-line frame-top\" data-kid=\"1\"></div>\n<div class=\"frame-line frame-bottom\" data-kid=\"2\"></div>\n<div class=\"frame-line frame-left\" data-kid=\"3\"></div>\n<div class=\"frame-line frame-right\" data-kid=\"4\"></div>\n\n\n<div class=\"nav-corner top-0 left-0 mt-8 ml-8 font-mono\" data-kid=\"5\">CHANDRASHEKAR</div>\n<div class=\"nav-corner top-0 right-0 mt-8 mr-8\" data-kid=\"6\">\n  <ul class=\"flex gap-8 list-none m-0 p-0\" data-kid=\"7\">\n    <li data-kid=\"8\"><a href=\"#about\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"9\">ABOUT</a></li>\n    <li data-kid=\"10\"><a href=\"#projects\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"11\">WORK</a></li>\n    <li data-kid=\"12\"><a href=\"#contact\" class=\"hover:text-purple-400 transition-colors\" data-kid=\"13\">CONTACT</a></li>\n  </ul>\n</div>\n<div class=\"nav-corner bottom-0 left-0 mb-8 ml-8 font-mono\" data-kid=\"14\">FULL STACK DEVELOPER</div>\n<div class=\"nav-corner bottom-0 right-0 mb-8 mr-8 flex gap-4\" data-kid=\"15\">\n  <a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"16\">LN</a>\n  <a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"17\">GH</a>\n  <a href=\"#\" class=\"hover:text-pink-400 transition-colors\" data-kid=\"18\">TW</a>\n</div>\n\n\n<main data-kid=\"19\">\n  \n  <section class=\"relative h-screen flex items-center justify-center overflow-hidden\" data-kid=\"20\">\n    <video src=\"https://videos.pexels.com/video-files/11944710/11944710-hd_1366_720_30fps.mp4\" poster=\"https://images.pexels.com/videos/11944710/pexels-photo-11944710.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover opacity-40 scale-110\" data-kid=\"21\"></video>\n    \n    <div class=\"relative z-10 text-center max-w-4xl px-4\" data-kid=\"22\">\n      <h1 class=\"text-6xl md:text-8xl font-thin tracking-tighter leading-none mb-6 reveal-text\" data-kid=\"23\">\n        Crafting digital <br data-kid=\"24\">\n        <span class=\"font-extralight italic\" data-kid=\"25\">experiences.</span>\n      </h1>\n      <p class=\"font-mono text-xs tracking-widest text-purple-400/80 reveal-text-delay\" data-kid=\"26\">\n        JAVA // SPRING BOOT // REACT\n      </p>\n    </div>\n\n    \n    <div class=\"absolute bottom-20 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-30\" data-kid=\"27\">\n      <div class=\"w-px h-16 bg-gradient-to-b from-transparent to-white\" data-kid=\"28\"></div>\n      <span class=\"font-mono text-[8px] tracking-[0.4em]\" data-kid=\"29\">SCROLL</span>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"relative py-40 px-8 md:px-24\" data-kid=\"30\">\n    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12 items-center\" data-kid=\"31\">\n      <div class=\"md:col-span-5 relative group\" data-kid=\"32\">\n        <div class=\"absolute inset-0 bg-purple-600/20 blur-[120px] rounded-full animate-pulse-slow -z-10\" data-kid=\"33\"></div>\n        <img src=\"https://images.unsplash.com/photo-1637059880830-59a90102de77?auto=format&w=800&q=80&fit=crop\" alt=\"Chandrashekar Portrait\" class=\"w-full grayscale contrast-125 opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"34\">\n        <div class=\"absolute bottom-8 left-8 bg-black/40 backdrop-blur-md p-4 border border-white/10\" data-kid=\"35\">\n          <span class=\"font-mono text-[10px] block mb-1\" data-kid=\"36\">01 / IDENTITY</span>\n          <h2 class=\"text-xl font-thin tracking-wide\" data-kid=\"37\">ALDRICH MATTHEW</h2>\n        </div>\n      </div>\n      \n      <div class=\"md:col-span-7 md:pl-12\" data-kid=\"38\">\n        <p class=\"text-2xl md:text-4xl font-extralight leading-relaxed tracking-tight text-slate-300\" data-kid=\"39\">\n          I am a Full Stack Web Developer dedicated to building \n          <span class=\"text-white font-normal\" data-kid=\"40\">scalable and user-friendly</span> \n          applications. Currently at Kapil Technologies, I bridge the gap between \n          complex backend logic and fluid user interfaces.\n        </p>\n        <div class=\"mt-12 flex flex-wrap gap-12 font-mono text-[10px] tracking-widest text-slate-500\" data-kid=\"41\">\n          <div data-kid=\"42\">\n            <span class=\"block text-white mb-2\" data-kid=\"43\">EXPERIENCE</span>\n            KAPIL TECHNOLOGIES<br data-kid=\"44\">\n            TRY LOGIC SOFT SOLUTIONS\n          </div>\n          <div data-kid=\"45\">\n            <span class=\"block text-white mb-2\" data-kid=\"46\">LOCATION</span>\n            HYDERABAD, IN\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"relative py-40 min-h-screen overflow-hidden\" data-kid=\"47\">\n    <div class=\"text-center mb-24 relative z-10\" data-kid=\"48\">\n      <h2 class=\"text-4xl font-thin tracking-widest uppercase\" data-kid=\"49\">Expertise</h2>\n      <div class=\"w-24 h-px bg-purple-500/50 mx-auto mt-4\" data-kid=\"50\"></div>\n    </div>\n\n    <div class=\"relative w-full h-[600px] flex items-center justify-center\" data-kid=\"51\">\n      <canvas id=\"constellation\" data-kid=\"52\"></canvas>\n      \n      \n      <div class=\"skill-container relative w-full max-w-4xl h-full mx-auto\" data-kid=\"53\">\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-32 h-32\" style=\"top: 10%; left: 20%;\" data-kid=\"54\">\n          <span class=\"font-mono text-[10px] text-purple-400\" data-kid=\"55\">01</span>\n          <span class=\"text-xs tracking-widest font-thin\" data-kid=\"56\">JAVA</span>\n        </div>\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-32 h-32\" style=\"top: 40%; left: 10%;\" data-kid=\"57\">\n          <span class=\"font-mono text-[10px] text-purple-400\" data-kid=\"58\">02</span>\n          <span class=\"text-xs tracking-widest font-thin uppercase\" data-kid=\"59\">Spring Boot</span>\n        </div>\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-40 h-40\" style=\"top: 30%; left: 45%;\" data-kid=\"60\">\n          <span class=\"font-mono text-[10px] text-pink-400\" data-kid=\"61\">03</span>\n          <span class=\"text-sm tracking-[0.2em] font-light\" data-kid=\"62\">REACT.JS</span>\n        </div>\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-28 h-28\" style=\"top: 15%; left: 70%;\" data-kid=\"63\">\n          <span class=\"font-mono text-[10px] text-purple-400\" data-kid=\"64\">04</span>\n          <span class=\"text-xs tracking-widest font-thin\" data-kid=\"65\">MYSQL</span>\n        </div>\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-36 h-36\" style=\"top: 60%; left: 30%;\" data-kid=\"66\">\n          <span class=\"font-mono text-[10px] text-purple-400\" data-kid=\"67\">05</span>\n          <span class=\"text-xs tracking-widest font-thin\" data-kid=\"68\">NODE.JS</span>\n        </div>\n        <div class=\"skill-node glass absolute p-4 rounded-full flex flex-col items-center justify-center w-28 h-28\" style=\"top: 65%; left: 65%;\" data-kid=\"69\">\n          <span class=\"font-mono text-[10px] text-purple-400\" data-kid=\"70\">06</span>\n          <span class=\"text-xs tracking-widest font-thin\" data-kid=\"71\">GIT</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"relative py-40 bg-[#050505]\" data-kid=\"72\">\n    <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"73\">\n      <h2 class=\"text-6xl font-thin tracking-tighter mb-40 text-center\" data-kid=\"74\">Selected Works</h2>\n      \n      <div class=\"space-y-60\" data-kid=\"75\">\n        \n        <div class=\"project-item sticky top-40 grid grid-cols-1 md:grid-cols-2 gap-12 items-center bg-black/80 backdrop-blur-xl p-12 rounded-2xl border border-white/5 shadow-2xl\" data-kid=\"76\">\n          <div class=\"order-2 md:order-1\" data-kid=\"77\">\n            <span class=\"font-mono text-purple-400 text-xs mb-4 block tracking-[0.4em]\" data-kid=\"78\">PROFESSIONAL</span>\n            <h3 class=\"text-4xl font-thin mb-6 tracking-wide\" data-kid=\"79\">PTKCS PORTAL</h3>\n            <p class=\"text-slate-400 font-light leading-relaxed mb-8\" data-kid=\"80\">\n              A robust company portal designed for Kapil Technologies, featuring advanced data visualization and management tools built with React and MongoDB.\n            </p>\n            <div class=\"flex gap-4 font-mono text-[10px] text-slate-500\" data-kid=\"81\">\n              <span data-kid=\"82\">REACT</span>\n              <span data-kid=\"83\">NODE</span>\n              <span data-kid=\"84\">MONGODB</span>\n            </div>\n          </div>\n          <div class=\"order-1 md:order-2\" data-kid=\"85\">\n            <img src=\"https://images.unsplash.com/photo-1761998066489-4f32b9a4dff8?auto=format&w=800&q=80&fit=crop\" class=\"w-full rounded-lg grayscale hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"86\">\n          </div>\n        </div>\n\n        \n        <div class=\"project-item sticky top-48 grid grid-cols-1 md:grid-cols-2 gap-12 items-center bg-black/80 backdrop-blur-xl p-12 rounded-2xl border border-white/5 shadow-2xl\" data-kid=\"87\">\n          <div class=\"order-2\" data-kid=\"88\">\n            <img src=\"https://images.unsplash.com/photo-1762081512138-1c0896b35666?auto=format&w=800&q=80&fit=crop\" class=\"w-full rounded-lg grayscale hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"89\">\n          </div>\n          <div class=\"order-1\" data-kid=\"90\">\n            <span class=\"font-mono text-pink-400 text-xs mb-4 block tracking-[0.4em]\" data-kid=\"91\">INTERNSHIP</span>\n            <h3 class=\"text-4xl font-thin mb-6 tracking-wide\" data-kid=\"92\">ODOO CRM</h3>\n            <p class=\"text-slate-400 font-light leading-relaxed mb-8\" data-kid=\"93\">\n              Customized Odoo modules for enhanced customer relationship management, optimizing business workflows and data integrity.\n            </p>\n            <div class=\"flex gap-4 font-mono text-[10px] text-slate-500\" data-kid=\"94\">\n              <span data-kid=\"95\">PYTHON</span>\n              <span data-kid=\"96\">ODOO</span>\n              <span data-kid=\"97\">POSTGRESQL</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"relative py-60 flex flex-col items-center justify-center overflow-hidden bg-black\" data-kid=\"98\">\n    <div class=\"absolute inset-0 bg-gradient-to-t from-purple-900/10 to-transparent -z-10\" data-kid=\"99\"></div>\n    \n    <div class=\"relative z-10 text-center\" data-kid=\"100\">\n      <h2 class=\"text-4xl md:text-6xl font-thin tracking-tight mb-12\" data-kid=\"101\">Let's create something <br data-kid=\"102\"><span class=\"font-extralight italic\" data-kid=\"103\">extraordinary.</span></h2>\n      \n      <a href=\"mailto:hanumanthuchandrashekar972@gmail.com\" class=\"resume-pill glass px-12 py-5 rounded-full inline-flex items-center gap-4 group hover:bg-white hover:text-black transition-all duration-500\" data-kid=\"104\">\n        <span class=\"font-mono text-xs tracking-widest\" data-kid=\"105\">GET IN TOUCH</span>\n        <i class=\"ti ti-sparkles group-hover:rotate-45 transition-transform duration-500\" data-kid=\"106\"></i>\n      </a>\n\n      <div class=\"mt-40 grid grid-cols-1 md:grid-cols-3 gap-20 text-[10px] font-mono tracking-[0.3em] text-slate-500 uppercase\" data-kid=\"107\">\n        <div data-kid=\"108\">\n          <span class=\"block text-white mb-4\" data-kid=\"109\">PHONE</span>\n          +91 8500394181\n        </div>\n        <div data-kid=\"110\">\n          <span class=\"block text-white mb-4\" data-kid=\"111\">RESUME</span>\n          <a href=\"#\" class=\"hover:text-purple-400\" data-kid=\"112\">DOWNLOAD PDF</a>\n        </div>\n        <div data-kid=\"113\">\n          <span class=\"block text-white mb-4\" data-kid=\"114\">STATUS</span>\n          OPEN TO WORK\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"light-leak absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-purple-600/20 via-pink-600/5 to-transparent blur-3xl opacity-50\" data-kid=\"115\"></div>\n  </footer>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"116\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"117\"></script>\n<script type=\"module\" data-kid=\"118\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Smooth Scroll\n  const lenis = new Lenis();\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n  gsap.ticker.lagSmoothing(0);\n\n  // Animations\n  gsap.from(\".reveal-text\", {\n    opacity: 0,\n    y: 100,\n    duration: 2,\n    ease: \"expo.out\",\n    stagger: 0.2\n  });\n\n  gsap.from(\".reveal-text-delay\", {\n    opacity: 0,\n    duration: 3,\n    delay: 1,\n    ease: \"power2.out\"\n  });\n\n  // Project Scroll parallax\n  gsap.utils.toArray('.project-item').forEach((item, i) => {\n    gsap.from(item, {\n      opacity: 0,\n      scale: 0.95,\n      y: 100,\n      scrollTrigger: {\n        trigger: item,\n        start: \"top bottom-=100\",\n        end: \"top center\",\n        scrub: true,\n      }\n    });\n  });\n\n  // Constellation Logic\n  const canvas = document.getElementById('constellation');\n  const ctx = canvas.getContext('2d');\n  const nodes = document.querySelectorAll('.skill-node');\n\n  function resizeCanvas() {\n    canvas.width = canvas.offsetWidth;\n    canvas.height = canvas.offsetHeight;\n  }\n  window.addEventListener('resize', resizeCanvas);\n  resizeCanvas();\n\n  function drawConstellation() {\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    ctx.strokeStyle = 'rgba(147, 51, 234, 0.15)';\n    ctx.lineWidth = 1;\n\n    const positions = Array.from(nodes).map(node => {\n      const rect = node.getBoundingClientRect();\n      const parentRect = node.parentElement.getBoundingClientRect();\n      return {\n        x: rect.left - parentRect.left + rect.width / 2,\n        y: rect.top - parentRect.top + rect.height / 2\n      };\n    });\n\n    for (let i = 0; i < positions.length; i++) {\n      for (let j = i + 1; j < positions.length; j++) {\n        const dist = Math.hypot(positions[i].x - positions[j].x, positions[i].y - positions[j].y);\n        if (dist < 300) {\n          ctx.beginPath();\n          ctx.moveTo(positions[i].x, positions[i].y);\n          ctx.lineTo(positions[j].x, positions[j].y);\n          ctx.stroke();\n        }\n      }\n    }\n    requestAnimationFrame(drawConstellation);\n  }\n  drawConstellation();\n\n  // Skill Node Hover Effect\n  nodes.forEach(node => {\n    node.addEventListener('mouseenter', () => {\n      gsap.to(node, { \n        borderColor: 'rgba(147, 51, 234, 0.8)', \n        backgroundColor: 'rgba(147, 51, 234, 0.1)',\n        scale: 1.05,\n        duration: 0.4 \n      });\n    });\n    node.addEventListener('mouseleave', () => {\n      gsap.to(node, { \n        borderColor: 'rgba(255, 255, 255, 0.05)', \n        backgroundColor: 'rgba(255, 255, 255, 0.03)',\n        scale: 1,\n        duration: 0.4 \n      });\n    });\n  });\n\n  // Footer Light Pulse\n  gsap.to(\".light-leak\", {\n    opacity: 0.8,\n    scaleY: 1.5,\n    duration: 5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n</script>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"119\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"120\">",
