\"133\">\n                    <label class=\"block text-[var(--color-text)]/40 text-[10px] uppercase mb-2 font-mono\" data-kid=\"134\">Identifier_Name</label>\n                    <input type=\"text\" class=\"w-full bg-white/5 border-b border-[var(--color-text)]/20 px-4 py-3 focus:outline-hidden focus:border-[var(--color-accent)] focus:bg-white/10 transition-all text-lg font-mono\" placeholder=\"GUEST_USER\" data-kid=\"135\">\n                </div>\n                <div class=\"relative group\" data-kid=\"136\">\n                    <label class=\"block text-[var(--color-text)]/40 text-[10px] uppercase mb-2 font-mono\" data-kid=\"137\">Return_Address_Email</label>\n                    <input type=\"email\" class=\"w-full bg-white/5 border-b border-[var(--color-text)]/20 px-4 py-3 focus:outline-hidden focus:border-[var(--color-accent)] focus:bg-white/10 transition-all text-lg font-mono\" placeholder=\"MAIL@RECIPIENT.NET\" data-kid=\"138\">\n                </div>\n                <div class=\"relative group\" data-kid=\"139\">\n                    <label class=\"block text-[var(--color-text)]/40 text-[10px] uppercase mb-2\" data-kid=\"140\">Transmission_Payload</label>\n                    <textarea class=\"w-full bg-transparent border border-[var(--color-text)]/20 rounded-xl p-4 focus:outline-hidden focus:border-[var(--color-accent)] transition-colors min-h-[150px] text-lg resize-none\" placeholder=\"Type your message here...\" data-kid=\"141\"></textarea>\n                    <span class=\"terminal-cursor absolute bottom-4 right-4 animate-pulse\" data-kid=\"142\"></span>\n                </div>\n\n                <button type=\"submit\" class=\"w-full py-6 bg-[var(--color-accent)] text-white font-bold uppercase tracking-[0.5em] hover:brightness-125 transition-all active:scale-[0.98] group flex items-center justify-center gap-4\" data-kid=\"143\">\n                    SEND_PACKET\n                    <i class=\"ti ti-send transition-transform group-hover:translate-x-2\" data-kid=\"144\"></i>\n                </button>\n            </form>\n        </div>\n    </div>\n</section>\n\n\n<footer class=\"py-12 px-8 border-t border-white/5 bg-black/20\" data-kid=\"145\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"146\">\n        <div class=\"font-heading font-bold text-2xl tracking-tighter\" data-kid=\"147\">\n            NEON_<span class=\"text-[var(--color-accent)]\" data-kid=\"148\">ABYSS</span>\n        </div>\n        <div class=\"flex gap-8 text-[10px] font-mono uppercase tracking-[0.3em] opacity-40\" data-kid=\"149\">\n            <a href=\"#\" class=\"hover:text-[var(--color-text)] hover:opacity-100 transition-all\" data-kid=\"150\">Twitter</a>\n            <a href=\"#\" class=\"hover:text-[var(--color-text)] hover:opacity-100 transition-all\" data-kid=\"151\">GitHub</a>\n            <a href=\"#\" class=\"hover:text-[var(--color-text)] hover:opacity-100 transition-all\" data-kid=\"152\">Behance</a>\n        </div>\n        <div class=\"text-[10px] font-mono opacity-40\" data-kid=\"153\">\n            &copy; 2024 LAB_V2.0. ALL RIGHTS RESERVED.\n        </div>\n    </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"154\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"155\"></script>\n<script type=\"module\" data-kid=\"156\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    // Initializations\n    gsap.registerPlugin(ScrollTrigger);\n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // Custom Cursor\n    const cursor = document.querySelector('.custom-cursor');\n    window.addEventListener('mousemove', (e) => {\n        animate(cursor, { \n            x: e.clientX - 10, \n            y: e.clientY - 10 \n        }, { duration: 0.1 });\n    });\n\n    // 1. Entrance Reveals (GSAP Blur In)\n    gsap.from(\"#hero-panel-1\", {\n        autoAlpha: 0,\n        filter: \"blur(40px)\",\n        y: 80,\n        duration: 1.5,\n        ease: \"expo.out\",\n        delay: 0.3\n    });\n    gsap.from(\"#hero-panel-2\", {\n        autoAlpha: 0,\n        filter: \"blur(20px)\",\n        x: -60,\n        duration: 1.2,\n        ease: \"power4.out\",\n        delay: 1\n    });\n    gsap.from(\"#hero-panel-3\", {\n        autoAlpha: 0,\n        filter: \"blur(25px)\",\n        scale: 0.8,\n        duration: 1.4,\n        ease: \"expo.out\",\n        delay: 1.2\n    });\n\n    // Parallax on Scroll for Hero\n    gsap.to(\"#hero-panel-1\", {\n        scrollTrigger: {\n            trigger: \"#hero\",\n            start: \"top top\",\n            scrub: true\n        },\n        y: -100,\n        opacity: 0.2\n    });\n    gsap.to(\"#hero-panel-3\", {\n        scrollTrigger: {\n            trigger: \"#hero\",\n            start: \"top top\",\n            scrub: true\n        },\n        y: -150,\n        rotate: 10\n    });\n\n    // 2. Laboratory Masonry Reveal (Batch Card Reveals)\n    ScrollTrigger.batch(\".lab-card\", {\n        start: \"top 85%\",\n        onEnter: (elements) => {\n            gsap.from(elements, {\n                autoAlpha: 0,\n                y: 50,\n                stagger: 0.15,\n                duration: 0.8,\n                ease: \"power3.out\",\n                overwrite: true\n            });\n        }\n    });\n\n    // 3. Lab Image Reveal on Hover (Anime.js)\n    document.querySelectorAll('.lab-card').forEach(card => {\n        const revealImg = card.querySelector('.hover-reveal-img');\n        if (!revealImg) return;\n        \n        card.addEventListener('mouseenter', () => {\n            animate(revealImg, { \n                clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'],\n                duration: 800,\n                ease: 'outExpo'\n            });\n        });\n        card.addEventListener('mouseleave', () => {\n            animate(revealImg, { \n                clipPath: ['inset(0 0% 0 0)', 'inset(0 100% 0 0)'],\n                duration: 600,\n                ease: 'inOutQuad'\n            });\n        });\n    });\n\n    // 4. Tech Orbit Drag & Rotate (Anime.js)\n    const orbitRoot = document.getElementById('orbit-root');\n    const rings = document.querySelectorAll('.orbit-ring');\n    let currentRotation = 0;\n    let isDragging = false;\n    let startX = 0;\n\n    orbitRoot.addEventListener('mousedown', (e) => {\n        isDragging = true;\n        startX = e.clientX;\n        orbitRoot.style.cursor = 'grabbing';\n    });\n\n    window.addEventListener('mousemove', (e) => {\n        if (!isDragging) return;\n        const delta = (e.clientX - startX) * 0.5;\n        currentRotation += delta;\n        startX = e.clientX;\n        \n        rings.forEach((ring, i) => {\n            const speed = (i + 1) * 0.8;\n            animate(ring, {\n                rotate: currentRotation * speed,\n                duration: 100,\n                ease: 'outQuad'\n            });\n            ring.querySelectorAll('.token').forEach(token => {\n                animate(token, {\n                    rotate: -currentRotation * speed,\n                    duration: 100,\n                    ease: 'outQuad'\n                });\n            });\n        });\n    });\n\n    window.addEventListener('mouseup', () => {\n        isDragging = false;\n        orbitRoot.style.cursor = 'grab';\n    });\n\n    // Ambient Loop for Orbit\n    animate(\".orbit-ring\", {\n        rotate: '1turn',\n        duration: 40000,\n        repeat: Infinity,\n        ease: 'linear'\n    });\n\n    // 5. Terminal Typewriter Effect (Anime.js)\n    const outputLines = document.querySelectorAll('.terminal-line');\n    \n    ScrollTrigger.create({\n        trigger: \"#terminal-window\",\n        start: \"top 70%\",\n        onEnter: () => {\n            outputLines.forEach((line, i) => {\n                // Char splitting for true typewriter\n                const text = line.innerText;\n                line.innerHTML = '';\n                [...text].forEach(char => {\n                    const span = document.createElement('span');\n                    span.innerText = char;\n                    span.style.opacity = '0';\n                    line.appendChild(span);\n                });\n\n                animate(line.querySelectorAll('span'), {\n                    opacity: [0, 1],\n                    duration: 10,\n                    delay: (el, idx) => (i * 1000) + (idx * 20),\n                    ease: 'linear'\n                });\n            });\n        }\n    });\n\n</script>\n",
